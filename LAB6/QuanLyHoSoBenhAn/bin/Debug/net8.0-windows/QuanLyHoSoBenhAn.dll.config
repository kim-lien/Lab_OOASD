<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<startup useLegacyV2RuntimeActivationPolicy="true">
		<supportedRuntime
			version="v4.0"
			sku=".NETFramework,Version=v4.7.2" />
	</startup>
  <connectionStrings>
    
    <add name="QuanLyBenhAnDb"
         connectionString="Data Source=ADMIN;Initial Catalog=QuanLyBenhAn;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
