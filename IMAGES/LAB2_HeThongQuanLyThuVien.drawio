        <UserObject label="Sequence Diagram nghiệp vụ Mượn sách" plantUmlId="title_24" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sequence Diagram nghiệp vụ Mượn sách" id="uMvYxWWLsgdm8BCSbLjk-242">
          <mxCell parent="uMvYxWWLsgdm8BCSbLjk-217" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="300.3087999999999" x="373.08683571428577" y="4490" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Sequence Diagram nghiệp vụ trả sách và lập phiếu phạt\n\nskinparam linetype ortho\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam sequence {\n    ArrowColor Black\n    LifeLineBorderColor Black\n    LifeLineBackgroundColor White\n    ParticipantBorderColor Black\n    ParticipantBackgroundColor White\n    ActivationBorderColor Black\n    ActivationBackgroundColor White\n    MessageAlign center\n}\n\nparticipant \&quot;Độc giả\&quot; as DG\nparticipant \&quot;Thủ thư\&quot; as TT\nparticipant \&quot;FrmDocgia\&quot; as Form\nparticipant \&quot;DocGiaService\&quot; as Service\nparticipant \&quot;SQL Server\&quot; as DB\n\nactivate DG\nDG -&gt; TT : 1. Mang sách đến trả\nactivate TT\n\nTT -&gt; Form : 2. Chọn phiếu mượn,\\nnhập tình trạng sách\nactivate Form\n\nForm -&gt; Service : 3. Kiểm tra thông tin mượn\nactivate Service\n\nService -&gt; DB : 4. Lấy thông tin chi tiết\nactivate DB\nDB --&gt; Service : 5. Trả về thông tin\ndeactivate DB\n\nService -&gt; DB : 6. Kiểm tra quá hạn/hư hỏng/\\nmất\nactivate DB\nDB --&gt; Service : 7. Kết quả kiểm tra\ndeactivate DB\n\nService -&gt; DB : 8. Tính phí phạt\nactivate DB\ndeactivate DB\n\nService -&gt; DB : 9. Lập phiếu phạt\nactivate DB\n\nService -&gt; DB : 10. Lưu phiếu phạt\n\nDB --&gt; Service : 11. Kết quả\ndeactivate DB\n\nService --&gt; Form : 12. Thông báo lập phiếu phạt\n\nService -&gt; DB : 13. Cập nhật tình trạng trả sách\nactivate DB\n\nService -&gt; DB : 14. Cập nhật số lượng sách\n\nDB --&gt; Service : 11. Kết quả\ndeactivate DB\n\nService --&gt; Form : 16. Thông báo trả sách thành công\ndeactivate Service\n\nForm -&gt; TT : Thông báo kết quả\ndeactivate Form\n\nTT -&gt; DG : 17. Nhận lại phiếu trả\ndeactivate TT\ndeactivate DG\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="uMvYxWWLsgdm8BCSbLjk-243">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
