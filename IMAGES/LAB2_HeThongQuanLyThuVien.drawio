        <UserObject label="Sequence Diagram nghiệp vụ cấp/gia hạn thẻ" plantUmlId="title_24" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sequence Diagram nghiệp vụ cấp/gia hạn thẻ" id="uMvYxWWLsgdm8BCSbLjk-216">
          <mxCell parent="uMvYxWWLsgdm8BCSbLjk-191" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="338.37829999999997" x="360.902075" y="3770" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Sequence Diagram nghiệp vụ Mượn sách\n\nskinparam linetype ortho\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam sequence {\n    ArrowColor Black\n    LifeLineBorderColor Black\n    LifeLineBackgroundColor White\n    ParticipantBorderColor Black\n    ParticipantBackgroundColor White\n    ActivationBorderColor Black\n    ActivationBackgroundColor White\n    MessageAlign center\n}\n\nparticipant \&quot;Độc giả\&quot; as DG\nparticipant \&quot;Thủ thư\&quot; as TT\nparticipant \&quot;FrmDocgia\&quot; as Form\nparticipant \&quot;DocGiaService\&quot; as Service\nparticipant \&quot;SQL Server\&quot; as DB\n\nactivate DG\nDG -&gt; TT : 1. Xuất trình thẻ,\\nyêu cầu mượn sách\nactivate TT\n\nTT -&gt; Form : 2. Nhập mã độc giả chọn sách\nactivate Form\n\nForm -&gt; Service : 3. Kiểm tra thẻ và\\nđiều kiện mượn\nactivate Service\n\nService -&gt; DB : 4. Kiểm tra thẻ, số sách\\nđang mượn\nactivate DB\n\nService -&gt; DB : 5. Kiểm tra tồn kho từng sách\n\nDB --&gt; Service : 6. Kết quả kiểm tra\ndeactivate DB\n\nService --&gt; TT : 7. Thông báo lỗi (lý do)\ndeactivate Service\n\nForm -&gt; DB : 8. Lập phiếu mượn\nactivate DB\n\nForm -&gt; DB : 9. Lưu chi tiết phiếu mượn\n\nForm -&gt; DB : 10. Cập nhật số lượng sách\n\nDB --&gt; Form : 11. Kết quả\ndeactivate DB\n\nForm --&gt; TT : 12. Thông báo mượn thành công\ndeactivate Form\n\nTT -&gt; DG : 13. Nhận sách và phiếu mượn\n\ndeactivate TT\ndeactivate DG\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="uMvYxWWLsgdm8BCSbLjk-217">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
