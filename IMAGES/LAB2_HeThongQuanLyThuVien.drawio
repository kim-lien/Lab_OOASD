        <UserObject label="Activity Diagram nghiệp vụ Thống kê" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="Activity Diagram nghiệp vụ Thống kê" id="uMvYxWWLsgdm8BCSbLjk-168">
          <mxCell parent="uMvYxWWLsgdm8BCSbLjk-137" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1">
