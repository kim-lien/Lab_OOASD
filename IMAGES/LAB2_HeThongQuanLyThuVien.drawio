        <UserObject label="Sequence Diagram nghiệp vụ quản lý độc giả" plantUmlId="title_19" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sequence Diagram nghiệp vụ quản lý độc giả" id="uMvYxWWLsgdm8BCSbLjk-190">
          <mxCell parent="uMvYxWWLsgdm8BCSbLjk-170" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="333.3306" x="426.68748571428574" y="3170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Sequence Diagram nghiệp vụ cấp/gia hạn thẻ\n\nskinparam linetype ortho\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam sequence {\n    ArrowColor Black\n    LifeLineBorderColor Black\n    LifeLineBackgroundColor White\n    ParticipantBorderColor Black\n    ParticipantBackgroundColor White\n    ActivationBorderColor Black\n    ActivationBackgroundColor White\n    MessageAlign center\n}\n\nparticipant \&quot;Độc giả\&quot; as DG\nparticipant \&quot;Thủ thư\&quot; as TT\nparticipant \&quot;FrmDocgia\&quot; as Form\nparticipant \&quot;DocGiaService\&quot; as Service\nparticipant \&quot;SQL Server\&quot; as DB\n\nactivate DG\nDG -&gt; TT : 1. Yêu cầu cấp/gia hạn\nactivate TT\n\nTT -&gt; Form : 2. Nhập thông tin thẻ\\n(ngày cấp, hạn, lệ phí...)\nactivate Form\n\nForm -&gt; Service : 3. Kiểm tra thẻ hiện có\nactivate Service\n\nForm -&gt; Service : 4. Tạo thẻ\\n(mã thẻ, ngày cấp, hạn, lệ phí)\n\nService -&gt; DB : 5. INSERT THEDOCGIA\nactivate DB\nDB --&gt; Service : 6. Kết quả\ndeactivate DB\n\nService --&gt; Form : 7. Thông báo cấp thẻ thành công\n\nForm -&gt; Service : 8. Cập nhật hạn sử dụng\\n(mã thẻ, hạn mới)\n\nService -&gt; DB : 9. UPDATE THEDOCGIA\nactivate DB\nDB --&gt; Service : 10. Kết quả\ndeactivate DB\n\nService --&gt; Form : 11. Thông báo gia hạn thành công\ndeactivate Service\n\nForm -&gt; TT : 12. Thông báo kết quả\nTT -&gt; DG\ndeactivate Form\ndeactivate TT\ndeactivate DG\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="uMvYxWWLsgdm8BCSbLjk-191">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
