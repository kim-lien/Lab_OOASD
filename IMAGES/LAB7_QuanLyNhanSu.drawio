        <UserObject label="USE CASE PHAN RA - QUAN LY THU VIEC VA KY HOP DONG LAO DONG" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="USE CASE PHAN RA - QUAN LY THU VIEC VA KY HOP DONG LAO DONG" id="AsHyVqTz-jWcbENKhpS6-4892">
          <mxCell parent="AsHyVqTz-jWcbENKhpS6-4858" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1">
            <mxGeometry height="24" width="521" x="534.5" y="3150" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle ACTIVITY DIAGRAM - QUAN LY THU VIEC VA KY HOP DONG LAO DONG\n\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam linetype ortho\nskinparam activity {\n  BackgroundColor white\n  BorderColor black\n  DiamondBackgroundColor white\n  DiamondBorderColor black\n}\n\n|Nhân viên|\nstart\n:Tiếp nhận thông báo thử việc;\n:Cung cấp thông tin cá nhân;\n\n|Trưởng phòng|\n:Tiếp nhận hồ sơ nhân viên;\n:Lập quyết định tuyển dụng;\n:Xác định phòng ban, thời gian\\nvà mức lương thử việc;\n\n|Giám đốc|\n:Xem xét quyết định tuyển dụng;\nif (Phê duyệt?) then (Có)\n  :Phê duyệt quyết định tuyển dụng;\nelse (Không)\n  :Yêu cầu chỉnh sửa quyết định;\n  |Trưởng phòng|\n  :Chỉnh sửa quyết định tuyển dụng;\n  |Giám đốc|\n  :Phê duyệt quyết định sau chỉnh sửa;\nendif\n\n|Nhân viên|\n:Tham gia quá trình thử việc;\n:Thực hiện công việc được giao;\n\n|Trưởng phòng|\n:Theo dõi quá trình thử việc;\n:Đánh giá kết quả thử việc;\n:Gửi kết quả đánh giá;\n\n|Giám đốc|\n:Xem xét và xác nhận kết quả;\n\nif (Thử việc đạt yêu cầu?) then (Đạt)\n\n  |Trưởng phòng|\n  :Lập hợp đồng lao động;\n  :Xác định loại hợp đồng,\\nmức lương và chức vụ;\n  :Trình hợp đồng cho Giám đốc;\n\n  |Giám đốc|\n  :Xem xét và ký hợp đồng;\n\n  |Nhân viên|\n  :Ký hợp đồng lao động;\n\n  |Trưởng phòng|\n  :Cập nhật trạng thái\\nnhân viên chính thức;\n\n  if (Hợp đồng dài hạn?) then (Có)\n    :Lập hồ sơ BHXH và BHYT;\n  else (Không)\n  endif\n\n  :Lưu hồ sơ hợp đồng;\n\nelse (Không đạt)\n\n  |Trưởng phòng|\n  :Ghi nhận kết quả không đạt;\n  :Cập nhật trạng thái\\nkết thúc thử việc;\n\n  |Nhân viên|\n  :Nhận thông báo kết thúc thử việc;\n\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AsHyVqTz-jWcbENKhpS6-4895">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
