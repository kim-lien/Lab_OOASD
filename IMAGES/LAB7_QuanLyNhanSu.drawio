        <UserObject label="ACTIVITY DIAGRAM - QUAN LY THU VIEC VA KY HOP DONG LAO DONG" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="ACTIVITY DIAGRAM - QUAN LY THU VIEC VA KY HOP DONG LAO DONG" id="AsHyVqTz-jWcbENKhpS6-4971">
          <mxCell parent="AsHyVqTz-jWcbENKhpS6-4895" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1">
            <mxGeometry height="24" width="525" x="560.25" y="4080" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle SEQUENCE DIAGRAM - LAP QUYET DINH KHEN THUONG\n\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam linetype ortho\nskinparam sequenceMessageAlign center\nskinparam responseMessageBelowArrow true\nautonumber\n\nactor \&quot;Nhân viên nhân sự\&quot; as NS\nactor \&quot;Giám đốc\&quot; as GD\n\nboundary \&quot;Giao diện khen thưởng\&quot; as UI\ncontrol \&quot;QuanLyKhenThuong\&quot; as QL\ndatabase \&quot;CSDL\&quot; as DB\n\nNS -&gt; UI : Chọn chức năng lập quyết định khen thưởng\nactivate UI\n\nUI -&gt; NS : Hiển thị biểu mẫu khen thưởng\nNS -&gt; UI : Nhập số quyết định, ngày, lý do,\\nsố tiền và loại đối tượng\n\nalt Khen thưởng cá nhân\n    NS -&gt; UI : Chọn nhân viên\n    UI -&gt; QL : kiemTraNhanVien(MaNV)\n    activate QL\n    QL -&gt; DB : Tìm nhân viên theo MaNV\n    DB --&gt; QL : Thông tin nhân viên\n    QL --&gt; UI : Kết quả kiểm tra\n    deactivate QL\n\nelse Khen thưởng tập thể\n    NS -&gt; UI : Chọn phòng ban\n    UI -&gt; QL : kiemTraPhongBan(MaPhongBan)\n    activate QL\n    QL -&gt; DB : Tìm phòng ban theo MaPhongBan\n    DB --&gt; QL : Thông tin phòng ban\n    QL --&gt; UI : Kết quả kiểm tra\n    deactivate QL\nend\n\nNS -&gt; UI : Nhấn nút Lập quyết định\nUI -&gt; QL : lapQuyetDinhKhenThuong(thongTin)\nactivate QL\n\nQL -&gt; QL : Kiểm tra dữ liệu nhập\n\nalt Dữ liệu không hợp lệ\n    QL --&gt; UI : Thông báo lỗi\n    UI --&gt; NS : Yêu cầu nhập lại thông tin\n\nelse Dữ liệu hợp lệ\n    QL -&gt; DB : Kiểm tra số quyết định\n    DB --&gt; QL : Kết quả kiểm tra\n\n    alt Số quyết định đã tồn tại\n        QL --&gt; UI : Thông báo trùng số quyết định\n        UI --&gt; NS : Yêu cầu chỉnh sửa\n\n    else Số quyết định hợp lệ\n        QL -&gt; DB : Lưu quyết định chờ phê duyệt\n        DB --&gt; QL : Lưu thành công\n\n        QL --&gt; UI : Gửi quyết định trình ký\n        UI --&gt; NS : Thông báo lập quyết định thành công\n\n        GD -&gt; UI : Xem quyết định khen thưởng\n        UI -&gt; QL : layThongTinQuyetDinh(MaQDKT)\n        QL -&gt; DB : Truy vấn quyết định\n        DB --&gt; QL : Thông tin quyết định\n        QL --&gt; UI : Hiển thị quyết định\n\n        alt Giám đốc phê duyệt\n            GD -&gt; UI : Ký duyệt quyết định\n            UI -&gt; QL : pheDuyetQuyetDinh(MaQDKT)\n            QL -&gt; DB : Cập nhật trạng thái đã duyệt\n            DB --&gt; QL : Cập nhật thành công\n            QL --&gt; UI : Thông báo phê duyệt thành công\n            UI --&gt; GD : Hiển thị kết quả\n\n        else Giám đốc không phê duyệt\n            GD -&gt; UI : Từ chối quyết định\n            UI -&gt; QL : tuChoiQuyetDinh(MaQDKT)\n            QL -&gt; DB : Cập nhật trạng thái từ chối\n            DB --&gt; QL : Cập nhật thành công\n            QL --&gt; UI : Thông báo từ chối\n            UI --&gt; NS : Yêu cầu xem xét lại quyết định\n        end\n    end\nend\n\ndeactivate QL\ndeactivate UI\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_4Hu9FlLag7m4QjDRHSu-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
