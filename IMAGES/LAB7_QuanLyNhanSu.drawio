        <UserObject label="USE CASE DIAGRAM TONG QUAT - QUAN LY NHAN SU SON DONG A" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="USE CASE DIAGRAM TONG QUAT - QUAN LY NHAN SU SON DONG A" id="AsHyVqTz-jWcbENKhpS6-4777">
