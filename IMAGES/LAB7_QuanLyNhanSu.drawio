        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle USE CASE PHAN RA - QUAN LY THU VIEC VA KY HOP DONG LAO DONG\n\nleft to right direction\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam linetype ortho\nskinparam actorStyle stickman\n\nactor \&quot;Nhân viên\&quot; as NV\nactor \&quot;Trưởng phòng\&quot; as TP\nactor \&quot;Giám đốc\&quot; as GD\n\nrectangle \&quot;HE THONG QUAN LY NHAN SU SON DONG A\&quot; {\n\n  usecase \&quot;Quản lý thử việc và\\nký hợp đồng lao động\&quot; as UC0\n\n  usecase \&quot;Tiếp nhận thử việc\&quot; as UC1\n  usecase \&quot;Lập quyết định tuyển dụng\&quot; as UC2\n  usecase \&quot;Theo dõi quá trình thử việc\&quot; as UC3\n  usecase \&quot;Đánh giá kết quả thử việc\&quot; as UC4\n  usecase \&quot;Xác nhận kết quả thử việc\&quot; as UC5\n  usecase \&quot;Lập hợp đồng lao động\&quot; as UC6\n  usecase \&quot;Ký hợp đồng chính thức\&quot; as UC7\n  usecase \&quot;Kết thúc thử việc\&quot; as UC8\n}\n\n&#39; LIEN KET ACTOR\nNV -- UC1\nNV -- UC3\nNV -- UC7\n\nTP -- UC2\nTP -- UC3\nTP -- UC4\nTP -- UC6\n\nGD -- UC5\nGD -- UC7\n\n&#39; QUAN HE INCLUDE\nUC0 ..&gt; UC1 : &lt;&lt;include&gt;&gt;\nUC0 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC0 ..&gt; UC3 : &lt;&lt;include&gt;&gt;\nUC0 ..&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC0 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\n\nUC7 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\n\n&#39; QUAN HE EXTEND\nUC6 ..&gt; UC0 : &lt;&lt;extend&gt;&gt;\\n[Thu viec dat]\nUC8 ..&gt; UC0 : &lt;&lt;extend&gt;&gt;\\n[Thu viec khong dat]\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AsHyVqTz-jWcbENKhpS6-4858">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
