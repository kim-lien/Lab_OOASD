        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle CLASS DIAGRAM - QUAN LY NHAN SU CONG TY SON DONG A\n\nhide circle\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam shadowing false\nskinparam backgroundColor white\ntop to bottom direction\n\nclass PhongBan {\n  MaPhongBan : string\n  TenPhongBan : string\n  DiaDiem : string\n  SoDienThoai : string\n  MoTa : string\n  --\n  themPhongBan()\n  suaPhongBan()\n  layDanhSachNhanVien()\n}\n\nclass NhanVien {\n  MaNV : string\n  HoTen : string\n  NgaySinh : DateTime\n  GioiTinh : string\n  DiaChi : string\n  SoDienThoai : string\n  Email : string\n  NgayVaoLam : DateTime\n  TrangThai : string\n  MaPhongBan : string\n  --\n  themNhanVien()\n  suaNhanVien()\n  xoaNhanVien()\n  timKiemNhanVien()\n  xemThongTin()\n}\n\nclass ChucVu {\n  MaChucVu : string\n  TenChucVu : string\n  MoTa : string\n  PhuCapChucVu : decimal\n  --\n  themChucVu()\n  suaChucVu()\n  xemChucVu()\n}\n\nclass QuyetDinhTuyenDung {\n  MaQDTD : string\n  SoQuyetDinh : string\n  NgayQuyetDinh : DateTime\n  MaNV : string\n  MaPhongBan : string\n  NgayBatDauThuViec : DateTime\n  NgayKetThucThuViec : DateTime\n  LuongThuViec : decimal\n  NoiDung : string\n  DieuKhoan : string\n  --\n  lapQuyetDinh()\n  suaQuyetDinh()\n  kiemTraThoiGianThuViec()\n}\n\nclass HopDongLaoDong {\n  MaHopDong : string\n  SoHopDong : string\n  MaNV : string\n  LoaiHopDong : string\n  NgayKy : DateTime\n  NgayBatDau : DateTime\n  NgayKetThuc : DateTime\n  NoiDungHopDong : string\n  TrangThai : string\n  --\n  lapHopDong()\n  suaHopDong()\n  kiemTraHieuLuc()\n}\n\nclass HoSoBaoHiem {\n  MaBaoHiem : string\n  MaHopDong : string\n  SoBHXH : string\n  SoBHYT : string\n  NgayThamGia : DateTime\n  MucDongBHXH : decimal\n  MucDongBHYT : decimal\n  TrangThai : string\n  --\n  lapHoSoBaoHiem()\n  capNhatBaoHiem()\n  tinhTienBaoHiem()\n}\n\nclass QuyetDinhLuong {\n  MaQDL : string\n  SoQuyetDinh : string\n  MaNV : string\n  NgayQuyetDinh : DateTime\n  NgayHieuLuc : DateTime\n  LuongCoBan : decimal\n  PhuCapLuong : decimal\n  PhuCapDocHai : decimal\n  NoiDung : string\n  --\n  lapQuyetDinhLuong()\n  suaQuyetDinhLuong()\n  tinhTongLuong()\n}\n\nclass QuyetDinhChucVu {\n  MaQDCV : string\n  SoQuyetDinh : string\n  MaNV : string\n  MaChucVu : string\n  NgayQuyetDinh : DateTime\n  NgayHieuLuc : DateTime\n  PhuCapChucVu : decimal\n  NoiDung : string\n  --\n  lapQuyetDinhChucVu()\n  suaQuyetDinhChucVu()\n  capNhatChucVu()\n}\n\nclass KeHoachTuan {\n  MaKeHoach : string\n  MaPhongBan : string\n  NgayBatDau : DateTime\n  NgayKetThuc : DateTime\n  NguoiLap : string\n  NgayLap : DateTime\n  NoiDung : string\n  TrangThai : string\n  --\n  lapKeHoach()\n  suaKeHoach()\n  phanCongCongViec()\n}\n\nclass CaLamViec {\n  MaCa : string\n  TenCa : string\n  GioBatDau : TimeSpan\n  GioKetThuc : TimeSpan\n  MoTa : string\n  --\n  themCaLamViec()\n  suaCaLamViec()\n  xemCaLamViec()\n}\n\nclass ChiTietPhanCong {\n  MaPhanCong : string\n  MaKeHoach : string\n  MaNV : string\n  MaCa : string\n  NgayLamViec : DateTime\n  NoiDungCongViec : string\n  GhiChu : string\n  --\n  themPhanCong()\n  suaPhanCong()\n  xoaPhanCong()\n}\n\nclass BangChamCong {\n  MaBangChamCong : string\n  MaPhongBan : string\n  Thang : int\n  Nam : int\n  NgayLap : DateTime\n  NguoiLap : string\n  TrangThai : string\n  --\n  lapBangChamCong()\n  suaBangChamCong()\n  tongHopChamCong()\n}\n\nclass ChiTietChamCong {\n  MaChiTietChamCong : string\n  MaBangChamCong : string\n  MaNV : string\n  NgayChamCong : DateTime\n  MaCa : string\n  GioVao : DateTime\n  GioRa : DateTime\n  SoGioLam : decimal\n  TrangThai : string\n  --\n  chamCong()\n  capNhatChamCong()\n  tinhSoGioLam()\n}\n\nclass PhieuPhuTroi {\n  MaPhieuPhuTroi : string\n  SoPhieu : string\n  NgayPhuTroi : DateTime\n  SoGioPhuTroi : decimal\n  HinhThucPhuTroi : string\n  NguoiLap : string\n  GhiChu : string\n  --\n  lapPhieuPhuTroi()\n  suaPhieuPhuTroi()\n  tinhTienPhuTroi()\n}\n\nclass ChiTietPhuTroi {\n  MaChiTietPhuTroi : string\n  MaPhieuPhuTroi : string\n  MaNV : string\n  SoGioThamGia : decimal\n  HeSoPhuTroi : decimal\n  ThanhTien : decimal\n  --\n  themChiTietPhuTroi()\n  suaChiTietPhuTroi()\n  tinhThanhTien()\n}\n\nclass QuyetDinhKhenThuong {\n  MaQDKT : string\n  SoQuyetDinh : string\n  NgayQuyetDinh : DateTime\n  LoaiDoiTuong : string\n  MaNV : string\n  MaPhongBan : string\n  LyDoKhenThuong : string\n  SoTienThuong : decimal\n  NguoiKy : string\n  --\n  lapQuyetDinhKhenThuong()\n  suaQuyetDinhKhenThuong()\n  xemQuyetDinh()\n}\n\nclass PhieuChiKhenThuong {\n  MaPhieuChi : string\n  MaQDKT : string\n  NgayChi : DateTime\n  SoTienChi : decimal\n  NguoiLap : string\n  HinhThucChi : string\n  GhiChu : string\n  --\n  lapPhieuChi()\n  xemPhieuChi()\n  xacNhanChiThuong()\n}\n\nclass QuyetDinhKyLuat {\n  MaQDKL : string\n  SoQuyetDinh : string\n  NgayQuyetDinh : DateTime\n  LoaiDoiTuong : string\n  MaNV : string\n  MaPhongBan : string\n  LyDoKyLuat : string\n  HinhThucKyLuat : string\n  SoTienPhat : decimal\n  NguoiKy : string\n  --\n  lapQuyetDinhKyLuat()\n  suaQuyetDinhKyLuat()\n  xemQuyetDinh()\n}\n\nclass PhieuThuNopPhat {\n  MaPhieuThu : string\n  MaQDKL : string\n  NgayThu : DateTime\n  SoTienThu : decimal\n  NguoiLap : string\n  HinhThucThu : string\n  GhiChu : string\n  --\n  lapPhieuThu()\n  xemPhieuThu()\n  xacNhanThuPhat()\n}\n\nclass BangLuong {\n  MaBangLuong : string\n  Thang : int\n  Nam : int\n  NgayLap : DateTime\n  NguoiLap : string\n  TongTienLuong : decimal\n  TrangThai : string\n  --\n  lapBangLuong()\n  tinhLuong()\n  tongHopLuong()\n}\n\nclass ChiTietBangLuong {\n  MaChiTietLuong : string\n  MaBangLuong : string\n  MaNV : string\n  LuongCoBan : decimal\n  SoNgayCong : decimal\n  PhuCapLuong : decimal\n  PhuCapChucVu : decimal\n  PhuCapDocHai : decimal\n  TienPhuTroi : decimal\n  TienThuong : decimal\n  TienPhat : decimal\n  TienBHXH : decimal\n  TienBHYT : decimal\n  ThucLanh : decimal\n  --\n  tinhLuongCoBan()\n  tinhPhuCap()\n  tinhKhauTru()\n  tinhThucLanh()\n}\n\n&#39; MOI LIEN KET GIUA CAC CLASS\n\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhTuyenDung\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhTuyenDung\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongLaoDong\nHopDongLaoDong \&quot;1\&quot; -- \&quot;0..1\&quot; HoSoBaoHiem\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhLuong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\nChucVu \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\n\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; KeHoachTuan\nKeHoachTuan \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietPhanCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhanCong\nCaLamViec \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhanCong\n\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; BangChamCong\nBangChamCong \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietChamCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietChamCong\nCaLamViec \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietChamCong\n\nPhieuPhuTroi \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhuTroi\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhuTroi\n\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKhenThuong\nPhongBan \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKhenThuong\nQuyetDinhKhenThuong \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuChiKhenThuong\n\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKyLuat\nPhongBan \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKyLuat\nQuyetDinhKyLuat \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuThuNopPhat\n\nBangLuong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietBangLuong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietBangLuong\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AsHyVqTz-jWcbENKhpS6-4340">
