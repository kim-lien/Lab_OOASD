        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle USE CASE DIAGRAM TONG QUAT - QUAN LY NHAN SU SON DONG A\n\nleft to right direction\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam linetype ortho\nskinparam actorStyle stickman\nskinparam packageStyle rectangle\n\nactor \&quot;Nhân viên nhân sự\&quot; as NS\nactor \&quot;Trưởng phòng/ban/\\nphân xưởng\&quot; as TP\nactor \&quot;Ban chấm công\&quot; as CC\nactor \&quot;Kế toán\&quot; as KT\nactor \&quot;Giám đốc\&quot; as GD\n\nrectangle \&quot;HE THONG QUAN LY NHAN SU CONG TY SON DONG A\&quot; {\n\n  usecase \&quot;Quản lý nhân viên\&quot; as UC01\n  usecase \&quot;Quản lý phòng ban\&quot; as UC02\n  usecase \&quot;Quản lý chức vụ\&quot; as UC03\n  usecase \&quot;Lập quyết định tuyển dụng\&quot; as UC04\n  usecase \&quot;Quản lý thử việc\&quot; as UC05\n  usecase \&quot;Quản lý hợp đồng lao động\&quot; as UC06\n  usecase \&quot;Quản lý hồ sơ bảo hiểm\&quot; as UC07\n  usecase \&quot;Quản lý quyết định lương\&quot; as UC08\n  usecase \&quot;Quản lý quyết định chức vụ\&quot; as UC09\n\n  usecase \&quot;Lập kế hoạch làm việc tuần\&quot; as UC10\n  usecase \&quot;Phân công ca làm việc\&quot; as UC11\n  usecase \&quot;Lập kế hoạch phụ trội\&quot; as UC12\n\n  usecase \&quot;Theo dõi kế hoạch làm việc\&quot; as UC13\n  usecase \&quot;Lập bảng chấm công\&quot; as UC14\n  usecase \&quot;Ghi nhận giờ phụ trội\&quot; as UC15\n  usecase \&quot;Quản lý phiếu phụ trội\&quot; as UC16\n\n  usecase \&quot;Lập quyết định khen thưởng\&quot; as UC17\n  usecase \&quot;Lập quyết định kỷ luật\&quot; as UC18\n  usecase \&quot;Quản lý phiếu chi khen thưởng\&quot; as UC19\n  usecase \&quot;Quản lý phiếu thu nộp phạt\&quot; as UC20\n\n  usecase \&quot;Tính lương hằng tháng\&quot; as UC21\n  usecase \&quot;Lập bảng lương\&quot; as UC22\n  usecase \&quot;Xem bảng lương\&quot; as UC23\n\n  usecase \&quot;Phê duyệt quyết định khen thưởng\&quot; as UC24\n  usecase \&quot;Phê duyệt quyết định kỷ luật\&quot; as UC25\n}\n\n&#39; NHAN VIEN NHAN SU\nNS -- UC01\nNS -- UC02\nNS -- UC03\nNS -- UC04\nNS -- UC05\nNS -- UC06\nNS -- UC07\nNS -- UC08\nNS -- UC09\nNS -- UC17\nNS -- UC18\n\n&#39; TRUONG PHONG\nTP -- UC05\nTP -- UC10\nTP -- UC11\nTP -- UC12\n\n&#39; BAN CHAM CONG\nCC -- UC13\nCC -- UC14\nCC -- UC15\nCC -- UC16\n\n&#39; KE TOAN\nKT -- UC19\nKT -- UC20\nKT -- UC21\nKT -- UC22\nKT -- UC23\n\n&#39; GIAM DOC\nGD -- UC24\nGD -- UC25\n\n&#39; QUAN HE INCLUDE\nUC04 ..&gt; UC01 : &lt;&lt;include&gt;&gt;\nUC06 ..&gt; UC05 : &lt;&lt;include&gt;&gt;\nUC10 ..&gt; UC11 : &lt;&lt;include&gt;&gt;\nUC16 ..&gt; UC15 : &lt;&lt;include&gt;&gt;\nUC21 ..&gt; UC14 : &lt;&lt;include&gt;&gt;\nUC21 ..&gt; UC16 : &lt;&lt;include&gt;&gt;\nUC22 ..&gt; UC21 : &lt;&lt;include&gt;&gt;\n\n&#39; QUAN HE EXTEND\nUC07 ..&gt; UC06 : &lt;&lt;extend&gt;&gt;\nUC12 ..&gt; UC10 : &lt;&lt;extend&gt;&gt;\nUC19 ..&gt; UC17 : &lt;&lt;extend&gt;&gt;\nUC20 ..&gt; UC18 : &lt;&lt;extend&gt;&gt;\n\n&#39; QUAN HE PHE DUYET\nUC17 ..&gt; UC24 : &lt;&lt;include&gt;&gt;\nUC18 ..&gt; UC25 : &lt;&lt;include&gt;&gt;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AsHyVqTz-jWcbENKhpS6-4701">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
