        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam shadowing false\n\nclass Tang {\n    MaTang: string\n    SoTang: int\n    MoTa: string\n    themTang()\n    suaTang()\n    xoaTang()\n    layDanhSachPhong()\n}\n\nclass VanPhong {\n    MaPhong: string\n    MaTang: string\n    DienTich: decimal\n    HuongPhong: string\n    DonGiaThue: decimal\n    TrangThai: string\n    themPhong()\n    suaPhong()\n    xoaPhong()\n    kiemTraTrangThai()\n    tinhGiaThue()\n}\n\nclass KhachHang {\n    MaKH: string\n    TenCongTy: string\n    DiaChi: string\n    DienThoai: string\n    Email: string\n    NguoiDaiDien: string\n    themKhachHang()\n    suaKhachHang()\n    xoaKhachHang()\n    timKiemKhachHang()\n}\n\nclass HopDongThue {\n    MaHD: string\n    MaKH: string\n    NgayKy: Date\n    NgayBatDau: Date\n    NgayKetThuc: Date\n    ThoiHanThue: int\n    TongTienThueThang: decimal\n    TrangThai: string\n    NoiDung: string\n    lapHopDong()\n    suaHopDong()\n    tinhTongTien()\n    kiemTraThoiHan()\n    kiemTraHieuLuc()\n}\n\nclass ChiTietHopDong {\n    MaHD: string\n    MaPhong: string\n    DonGiaThue: decimal\n    ThoiHanThue: int\n    NgayBatDau: Date\n    NgayKetThuc: Date\n    themPhongThue()\n    xoaPhongThue()\n    tinhTienThue()\n    kiemTraTrungLich()\n}\n\nclass PhieuGiaHan {\n    MaGiaHan: string\n    MaHD: string\n    MaPhong: string\n    NgayLap: Date\n    SoThangGiaHan: int\n    NgayBatDauMoi: Date\n    NgayKetThucMoi: Date\n    TrangThai: string\n    lapPhieuGiaHan()\n    kiemTraThoiHan()\n    kiemTraCongNo()\n    xacNhanGiaHan()\n}\n\nclass KyThanhToan {\n    MaKy: string\n    MaHD: string\n    MaPhong: string\n    ThangThu: int\n    LoaiKy: string\n    NgayBatDauKy: Date\n    NgayDenHan: Date\n    SoTienPhaiThu: decimal\n    TrangThai: string\n    taoKyThanhToan()\n    tinhSoTien()\n    kiemTraDenHan()\n    tinhCongNo()\n}\n\nclass ThanhToanTienThue {\n    MaThanhToan: string\n    MaKy: string\n    NgayThanhToan: Date\n    SoTien: decimal\n    HinhThucThanhToan: string\n    GhiChu: string\n    ghiNhanThanhToan()\n    kiemTraSoTien()\n    xemLichSuThanhToan()\n}\n\nclass DichVu {\n    MaDV: string\n    TenDV: string\n    DonViTinh: string\n    DonGia: decimal\n    TrangThai: string\n    themDichVu()\n    suaDichVu()\n    xoaDichVu()\n    capNhatDonGia()\n}\n\nclass HoaDonDichVu {\n    MaHoaDon: string\n    MaHD: string\n    MaPhong: string\n    Thang: int\n    Nam: int\n    NgayLap: Date\n    HanThanhToan: Date\n    TongTien: decimal\n    TrangThai: string\n    lapHoaDon()\n    tinhTongTien()\n    kiemTraThanhToan()\n}\n\nclass ChiTietHoaDon {\n    MaHoaDon: string\n    MaDV: string\n    SoLuong: decimal\n    DonGia: decimal\n    ThanhTien: decimal\n    themChiTiet()\n    suaChiTiet()\n    xoaChiTiet()\n    tinhThanhTien()\n}\n\nclass ThanhToanDichVu {\n    MaTTDV: string\n    MaHoaDon: string\n    NgayThanhToan: Date\n    SoTien: decimal\n    HinhThucThanhToan: string\n    ghiNhanThanhToan()\n    kiemTraSoTien()\n    xemLichSuThanhToan()\n}\n\nclass NhanVienVanPhong {\n    MaNV: string\n    MaKH: string\n    MaPhong: string\n    HoTen: string\n    HinhAnh: string\n    ChucVu: string\n    DienThoai: string\n    TrangThai: string\n    themNhanVien()\n    suaNhanVien()\n    xoaNhanVien()\n    capNhatPhongLamViec()\n}\n\nclass TheGiuXe {\n    MaThe: string\n    MaNV: string\n    BienSoXe: string\n    LoaiXe: string\n    HangXe: string\n    NgayCap: Date\n    TrangThai: string\n    capThe()\n    capNhatThe()\n    khoaThe()\n    timKiemThe()\n}\n\nclass PhieuKiemTra {\n    MaKiemTra: string\n    MaPhong: string\n    NgayKiemTra: Date\n    TinhTrang: string\n    KetLuan: string\n    NguoiKiemTra: string\n    lapPhieuKiemTra()\n    ghiNhanTinhTrang()\n    deXuatSuaChua()\n}\n\nclass PhieuXuPhat {\n    MaPhat: string\n    MaKiemTra: string\n    NgayLap: Date\n    LyDo: string\n    SoTienPhat: decimal\n    TrangThai: string\n    lapPhieuPhat()\n    tinhTienPhat()\n    xacNhanXuLy()\n}\n\nTang \&quot;1\&quot; *-- \&quot;1..*\&quot; VanPhong\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongThue\nHopDongThue \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietHopDong\nVanPhong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHopDong\nChiTietHopDong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGiaHan\nChiTietHopDong \&quot;1\&quot; *-- \&quot;1..*\&quot; KyThanhToan\nKyThanhToan \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToanTienThue\nChiTietHopDong \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDonDichVu\nHoaDonDichVu \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietHoaDon\nDichVu \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHoaDon\nHoaDonDichVu \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToanDichVu\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVienVanPhong\nVanPhong \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVienVanPhong\nNhanVienVanPhong \&quot;1\&quot; -- \&quot;0..*\&quot; TheGiuXe\nVanPhong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKiemTra\nPhieuKiemTra \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuXuPhat\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="klx-rK3QHMn63mA74Ug2-1">
