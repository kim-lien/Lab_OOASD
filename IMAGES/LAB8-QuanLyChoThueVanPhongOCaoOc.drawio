        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam linetype ortho\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Nhân viên quản lý cao ốc\&quot; as QL\nactor \&quot;Kế toán\&quot; as KT\n\nrectangle \&quot;QUY TRÌNH KÝ HỢP ĐỒNG VÀ THANH TOÁN\&quot; {\n\n    usecase \&quot;Lập hợp đồng thuê\&quot; as UC01\n    usecase \&quot;Chọn văn phòng thuê\&quot; as UC02\n    usecase \&quot;Kiểm tra phòng trống\&quot; as UC03\n    usecase \&quot;Kiểm tra thời hạn thuê\\n(tối thiểu 6 tháng)\&quot; as UC04\n    usecase \&quot;Quản lý chi tiết hợp đồng\&quot; as UC05\n\n    usecase \&quot;Tính tiền thuê\\n6 tháng đầu\&quot; as UC06\n    usecase \&quot;Thanh toán trước\\n6 tháng đầu\&quot; as UC07\n    usecase \&quot;Kích hoạt hợp đồng\&quot; as UC08\n\n    usecase \&quot;Quản lý kỳ thanh toán\&quot; as UC09\n    usecase \&quot;Thanh toán tiền thuê\\ntháng thứ 7 trở đi\&quot; as UC10\n\n    usecase \&quot;Ghi nhận dịch vụ sử dụng\&quot; as UC11\n    usecase \&quot;Lập hóa đơn dịch vụ\\ncuối tháng\&quot; as UC12\n    usecase \&quot;Thanh toán dịch vụ\&quot; as UC13\n\n    usecase \&quot;Kiểm tra công nợ\&quot; as UC14\n}\n\nKH -- UC01\nKH -- UC02\nKH -- UC07\nKH -- UC10\nKH -- UC13\n\nQL -- UC01\nQL -- UC03\nQL -- UC04\nQL -- UC05\nQL -- UC08\n\nKT -- UC06\nKT -- UC07\nKT -- UC09\nKT -- UC10\nKT -- UC11\nKT -- UC12\nKT -- UC13\nKT -- UC14\n\nUC01 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\nUC01 ..&gt; UC03 : &lt;&lt;include&gt;&gt;\nUC01 ..&gt; UC04 : &lt;&lt;include&gt;&gt;\nUC01 ..&gt; UC05 : &lt;&lt;include&gt;&gt;\n\nUC07 ..&gt; UC06 : &lt;&lt;include&gt;&gt;\nUC08 ..&gt; UC07 : &lt;&lt;include&gt;&gt;\n\nUC10 ..&gt; UC09 : &lt;&lt;include&gt;&gt;\n\nUC12 ..&gt; UC11 : &lt;&lt;include&gt;&gt;\nUC13 ..&gt; UC12 : &lt;&lt;include&gt;&gt;\n\nUC10 ..&gt; UC14 : &lt;&lt;include&gt;&gt;\nUC13 ..&gt; UC14 : &lt;&lt;include&gt;&gt;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="UbstFZCdQ7fLLNfaFVeH-67">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
