        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam linetype ortho\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Nhân viên quản lý cao ốc\&quot; as QL\nactor \&quot;Kế toán\&quot; as KT\nactor \&quot;Nhân viên hành chính\&quot; as HC\nactor \&quot;Nhân viên kỹ thuật\&quot; as KTH\nactor \&quot;Ban quản lý cao ốc\&quot; as BQL\n\nrectangle \&quot;HỆ THỐNG QUẢN LÝ CHO THUÊ VĂN PHÒNG\&quot; {\n\n    usecase \&quot;Xem thông tin văn phòng\&quot; as UC01\n    usecase \&quot;Yêu cầu thuê văn phòng\&quot; as UC02\n\n    usecase \&quot;Quản lý tầng\&quot; as UC03\n    usecase \&quot;Quản lý văn phòng\&quot; as UC04\n    usecase \&quot;Quản lý khách hàng\&quot; as UC05\n    usecase \&quot;Lập hợp đồng thuê\&quot; as UC06\n    usecase \&quot;Quản lý chi tiết hợp đồng\&quot; as UC07\n\n    usecase \&quot;Quản lý kỳ thanh toán\&quot; as UC08\n    usecase \&quot;Thu tiền thuê\&quot; as UC09\n    usecase \&quot;Quản lý dịch vụ\&quot; as UC10\n    usecase \&quot;Lập hóa đơn dịch vụ\&quot; as UC11\n    usecase \&quot;Thu tiền dịch vụ\&quot; as UC12\n    usecase \&quot;Kiểm tra công nợ\&quot; as UC13\n\n    usecase \&quot;Lập phiếu gia hạn\&quot; as UC14\n    usecase \&quot;Kiểm tra điều kiện gia hạn\&quot; as UC15\n\n    usecase \&quot;Quản lý nhân viên văn phòng\&quot; as UC16\n    usecase \&quot;Quản lý thẻ giữ xe\&quot; as UC17\n\n    usecase \&quot;Kiểm tra văn phòng\&quot; as UC18\n    usecase \&quot;Lập phiếu kiểm tra\&quot; as UC19\n    usecase \&quot;Lập phiếu xử phạt\&quot; as UC20\n\n    usecase \&quot;Thống kê và báo cáo\&quot; as UC21\n}\n\nKH -- UC01\nKH -- UC02\nKH -- UC06\nKH -- UC09\nKH -- UC12\nKH -- UC14\n\nQL -- UC03\nQL -- UC04\nQL -- UC05\nQL -- UC06\nQL -- UC07\nQL -- UC14\n\nKT -- UC08\nKT -- UC09\nKT -- UC10\nKT -- UC11\nKT -- UC12\nKT -- UC13\n\nHC -- UC16\nHC -- UC17\n\nKTH -- UC18\nKTH -- UC19\n\nBQL -- UC20\nBQL -- UC21\nBQL -- UC13\n\nUC06 ..&gt; UC07 : &lt;&lt;include&gt;&gt;\nUC14 ..&gt; UC15 : &lt;&lt;include&gt;&gt;\nUC15 ..&gt; UC13 : &lt;&lt;include&gt;&gt;\nUC18 ..&gt; UC19 : &lt;&lt;include&gt;&gt;\nUC20 ..&gt; UC18 : &lt;&lt;extend&gt;&gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="UbstFZCdQ7fLLNfaFVeH-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
