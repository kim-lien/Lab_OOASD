        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle ACTIVITY DIAGRAM - QUY TRINH THUE VA THANH TOAN VAN PHONG\n\nskinparam linetype ortho\nskinparam shadowing false\n\n|Khách hàng|\nstart\n:Tham khảo thông tin văn phòng;\n:Chọn một hoặc nhiều văn phòng;\n:Yêu cầu ký hợp đồng thuê;\n\n|Nhân viên quản lý|\n:Kiểm tra tình trạng văn phòng;\n:Kiểm tra thời hạn thuê;\n\nif (Phòng khả dụng và thuê từ 6 tháng?) then (Có)\n    :Nhập thông tin hợp đồng;\n    :Ghi nhận danh sách phòng thuê;\n\n    |Hệ thống|\n    :Lập hợp đồng thuê;\n    :Lưu chi tiết hợp đồng;\n    :Tính tiền thuê 6 tháng đầu;\n    :Tạo khoản phải thu ban đầu;\n\n    |Kế toán|\n    :Thông báo tiền thuê trả trước;\n\n    |Khách hàng|\n    :Thanh toán tiền thuê 6 tháng đầu;\n\n    |Kế toán|\n    :Ghi nhận số tiền thanh toán;\n\n    |Hệ thống|\n    if (Đã thanh toán đủ 6 tháng đầu?) then (Có)\n        :Kích hoạt hợp đồng;\n        :Cập nhật trạng thái phòng;\n    else (Không)\n        :Ghi nhận khoản còn nợ;\n        :Hợp đồng chờ thanh toán;\n        stop\n    endif\n\n    :Xác định tháng thuê hiện tại;\n\n    while (Hợp đồng còn thời hạn?) is (Có)\n\n        if (Từ tháng thứ 7 trở đi?) then (Có)\n            :Tạo kỳ thanh toán tiền thuê;\n            :Xác định hạn thanh toán đầu tháng;\n\n            |Kế toán|\n            :Thông báo tiền thuê phải trả;\n\n            |Khách hàng|\n            :Thanh toán tiền thuê tháng;\n\n            |Kế toán|\n            :Ghi nhận thanh toán tiền thuê;\n\n            |Hệ thống|\n            if (Đã thanh toán đủ?) then (Có)\n                :Cập nhật kỳ đã thanh toán;\n            else (Không)\n                :Ghi nhận công nợ tiền thuê;\n            endif\n        endif\n\n        :Ghi nhận dịch vụ sử dụng trong tháng;\n\n        if (Đến cuối tháng?) then (Có)\n            :Tổng hợp điện, nước, internet;\n            :Tính tổng chi phí dịch vụ;\n\n            if (Có dịch vụ phát sinh?) then (Có)\n                :Lập hóa đơn dịch vụ;\n\n                |Kế toán|\n                :Thông báo hóa đơn dịch vụ;\n\n                |Khách hàng|\n                :Thanh toán hóa đơn dịch vụ;\n\n                |Kế toán|\n                :Ghi nhận thanh toán dịch vụ;\n\n                |Hệ thống|\n                if (Đã thanh toán đủ dịch vụ?) then (Có)\n                    :Cập nhật hóa đơn đã thanh toán;\n                else (Không)\n                    :Ghi nhận công nợ dịch vụ;\n                endif\n            endif\n        endif\n\n        :Chuyển sang tháng thuê tiếp theo;\n\n    endwhile (Không)\n\n    :Cập nhật hợp đồng hết hạn;\n    :Lưu lịch sử thanh toán và công nợ;\n\nelse (Không)\n    |Nhân viên quản lý|\n    :Thông báo yêu cầu không hợp lệ;\n    :Yêu cầu chọn phòng hoặc sửa thời hạn;\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="UbstFZCdQ7fLLNfaFVeH-118">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
