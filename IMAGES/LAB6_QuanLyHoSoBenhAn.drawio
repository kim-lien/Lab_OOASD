        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle USE CASE TONG QUAT - QUAN LY HO SO BENH AN\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Benh nhan\&quot; as BN\nactor \&quot;Nhan vien\&quot; as NV\nactor \&quot;Bac si\&quot; as BS\nactor \&quot;Nhan vien xet nghiem\&quot; as XN\nactor \&quot;Admin\&quot; as AD\n\nrectangle \&quot;HE THONG QUAN LY HO SO BENH AN\&quot; {\n  usecase \&quot;Dang ky kham benh\&quot; as UC1\n  usecase \&quot;Quan ly benh nhan\&quot; as UC2\n  usecase \&quot;Thu le phi nam\&quot; as UC3\n  usecase \&quot;Quan ly ho so benh an\&quot; as UC4\n  usecase \&quot;Tra cuu ho so\&quot; as UC5\n  usecase \&quot;Kham benh\&quot; as UC6\n  usecase \&quot;Chi dinh xet nghiem\&quot; as UC7\n  usecase \&quot;Quan ly xet nghiem\&quot; as UC8\n  usecase \&quot;Lap toa thuoc\&quot; as UC9\n  usecase \&quot;Quan ly lich kham dinh ky\&quot; as UC10\n  usecase \&quot;Thanh toan vien phi\&quot; as UC11\n  usecase \&quot;Hoan tat dot dieu tri\&quot; as UC12\n  usecase \&quot;Quan ly khoa\&quot; as UC13\n  usecase \&quot;Quan ly bac si\&quot; as UC14\n  usecase \&quot;Quan ly thuoc\&quot; as UC15\n  usecase \&quot;Quan ly tai khoan\&quot; as UC16\n}\n\nBN -- UC1\nBN -- UC10\n\nNV -- UC1\nNV -- UC2\nNV -- UC3\nNV -- UC4\nNV -- UC5\nNV -- UC10\nNV -- UC11\nNV -- UC12\n\nBS -- UC5\nBS -- UC6\nBS -- UC7\nBS -- UC9\n\nXN -- UC8\n\nAD -- UC13\nAD -- UC14\nAD -- UC15\nAD -- UC16\n\nUC6 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC12 ..&gt; UC11 : &lt;&lt;include&gt;&gt;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="uqrvx1z-NkLdcgDsds0I-51">
