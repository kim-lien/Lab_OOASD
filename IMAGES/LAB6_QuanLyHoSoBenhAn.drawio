        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC4 - CAP HO SO BENH AN\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Benh nhan\&quot; as BN\nactor \&quot;Nhan vien\&quot; as NV\n\nrectangle \&quot;HE THONG QUAN LY HO SO BENH AN\&quot; {\n\n  usecase \&quot;Cap ho so benh an\&quot; as UC4\n  usecase \&quot;Kiem tra thong tin benh nhan\&quot; as UC41\n  usecase \&quot;Kiem tra le phi nam\&quot; as UC42\n  usecase \&quot;Kiem tra ho so da ton tai\&quot; as UC43\n  usecase \&quot;Tao ma ho so benh an\&quot; as UC44\n  usecase \&quot;Lap ho so benh an\&quot; as UC45\n  usecase \&quot;Luu thong tin ho so\&quot; as UC46\n  usecase \&quot;In ho so benh an\&quot; as UC47\n  usecase \&quot;Ban giao ho so\&quot; as UC48\n\n}\n\nBN -- UC4\nBN -- UC48\n\nNV -- UC4\nNV -- UC45\nNV -- UC47\nNV -- UC48\n\nUC4 ..&gt; UC41 : &lt;&lt;include&gt;&gt;\nUC4 ..&gt; UC42 : &lt;&lt;include&gt;&gt;\nUC4 ..&gt; UC43 : &lt;&lt;include&gt;&gt;\nUC4 ..&gt; UC44 : &lt;&lt;include&gt;&gt;\nUC4 ..&gt; UC45 : &lt;&lt;include&gt;&gt;\nUC4 ..&gt; UC46 : &lt;&lt;include&gt;&gt;\nUC4 ..&gt; UC48 : &lt;&lt;include&gt;&gt;\n\nUC47 ..&gt; UC4 : &lt;&lt;extend&gt;&gt;\n\nnote right of UC47\n  Thuc hien khi can\n  in ho so benh an\nend note\n\nnote right of UC42\n  Chi cap ho so khi\n  da dong le phi nam\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KhnMYgAfbm0gDm6oT-Hf-31">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
