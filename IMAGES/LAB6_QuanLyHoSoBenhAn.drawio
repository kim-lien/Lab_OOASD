        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC15 - THEM CHI TIET THUOC\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Bac si\&quot; as BS\n\nrectangle \&quot;HE THONG QUAN LY HO SO BENH AN\&quot; {\n\n  usecase \&quot;Them chi tiet thuoc\&quot; as UC15\n  usecase \&quot;Tra cuu toa thuoc\&quot; as UC151\n  usecase \&quot;Tim kiem thuoc\&quot; as UC152\n  usecase \&quot;Chon thuoc\&quot; as UC153\n  usecase \&quot;Nhap so luong thuoc\&quot; as UC154\n  usecase \&quot;Nhap lieu dung\&quot; as UC155\n  usecase \&quot;Nhap cach dung\&quot; as UC156\n  usecase \&quot;Kiem tra thong tin thuoc\&quot; as UC157\n  usecase \&quot;Luu chi tiet thuoc\&quot; as UC158\n  usecase \&quot;Them thuoc khac\&quot; as UC159\n  usecase \&quot;Chinh sua chi tiet thuoc\&quot; as UC1510\n  usecase \&quot;Xoa chi tiet thuoc\&quot; as UC1511\n\n}\n\nBS -- UC15\nBS -- UC153\nBS -- UC1510\nBS -- UC1511\n\nUC15 ..&gt; UC151 : &lt;&lt;include&gt;&gt;\nUC15 ..&gt; UC152 : &lt;&lt;include&gt;&gt;\nUC15 ..&gt; UC153 : &lt;&lt;include&gt;&gt;\nUC15 ..&gt; UC154 : &lt;&lt;include&gt;&gt;\nUC15 ..&gt; UC155 : &lt;&lt;include&gt;&gt;\nUC15 ..&gt; UC156 : &lt;&lt;include&gt;&gt;\nUC15 ..&gt; UC157 : &lt;&lt;include&gt;&gt;\nUC15 ..&gt; UC158 : &lt;&lt;include&gt;&gt;\n\nUC159 ..&gt; UC15 : &lt;&lt;extend&gt;&gt;\nUC1510 ..&gt; UC15 : &lt;&lt;extend&gt;&gt;\nUC1511 ..&gt; UC15 : &lt;&lt;extend&gt;&gt;\n\nnote right of UC159\n  Thuc hien khi bac si\n  muon them nhieu loai\n  thuoc vao toa\nend note\n\nnote right of UC1510\n  Thuc hien khi can\n  thay doi so luong,\n  lieu dung hoac cach dung\nend note\n\nnote right of UC1511\n  Thuc hien khi can\n  loai bo thuoc khoi toa\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KhnMYgAfbm0gDm6oT-Hf-428">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
