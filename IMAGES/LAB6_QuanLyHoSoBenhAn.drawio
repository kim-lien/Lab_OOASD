        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle CLASS DIAGRAM - QUAN LY HO SO BENH AN\n\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nhide circle\ntop to bottom direction\n\nclass BenhNhan {\n  MaBN: int\n  HoTen: string\n  NgaySinh: Date\n  DiaChi: string\n  SoDienThoai: string\n  Anh3x4: string\n  --\n  DangKy()\n  CapNhatThongTin()\n  TraCuuHoSo()\n}\n\nclass DangKyKhamBenh {\n  MaDK: int\n  MaBN: int\n  NgayDangKy: Date\n  LoaiDangKy: string\n  TrangThai: string\n  --\n  TaoDangKy()\n  CapNhatDangKy()\n  HuyDangKy()\n}\n\nclass LePhiNam {\n  MaLePhi: int\n  MaBN: int\n  NamDong: int\n  SoTien: decimal\n  NgayDong: Date\n  TrangThai: string\n  --\n  TinhLePhi()\n  ThanhToan()\n  KiemTraTrangThai()\n}\n\nclass HoSoBenhAn {\n  MaHoSo: int\n  MaBN: int\n  NgayLap: Date\n  LichSuKham: string\n  --\n  TaoHoSo()\n  CapNhatHoSo()\n  TraCuuHoSo()\n}\n\nclass Khoa {\n  MaKhoa: int\n  TenKhoa: string\n  MoTa: string\n  ViTri: string\n  SoDienThoai: string\n  --\n  ThemKhoa()\n  CapNhatKhoa()\n  TimKiemKhoa()\n}\n\nclass BacSi {\n  MaBS: int\n  MaKhoa: int\n  HoTen: string\n  ChuyenKhoa: string\n  SoDienThoai: string\n  --\n  KhamBenh()\n  ChiDinhXetNghiem()\n  LapToaThuoc()\n}\n\nclass PhieuKham {\n  MaPhieuKham: int\n  MaHoSo: int\n  MaBS: int\n  MaKhoa: int\n  MaDK: int\n  NgayGioKham: DateTime\n  TrieuChung: string\n  ChanDoan: string\n  --\n  TaoPhieuKham()\n  CapNhatKetQua()\n  XemPhieuKham()\n}\n\nclass XetNghiem {\n  MaXN: int\n  MaPhieuKham: int\n  TenXetNghiem: string\n  NgayXN: Date\n  KetQua: string\n  --\n  TaoPhieuXN()\n  CapNhatKetQua()\n  XemKetQua()\n}\n\nclass ToaThuoc {\n  MaToa: int\n  MaPhieuKham: int\n  NgayKeToa: Date\n  LoiDan: string\n  --\n  LapToaThuoc()\n  CapNhatToaThuoc()\n  XemToaThuoc()\n}\n\nclass Thuoc {\n  MaThuoc: int\n  TenThuoc: string\n  DonViTinh: string\n  CongDung: string\n  --\n  ThemThuoc()\n  SuaThuoc()\n  TimKiemThuoc()\n}\n\nclass ChiTietToaThuoc {\n  MaCTToa: int\n  MaToa: int\n  MaThuoc: int\n  SoLuong: int\n  LieuDung: string\n  CachDung: string\n  --\n  ThemChiTiet()\n  SuaChiTiet()\n  XoaChiTiet()\n}\n\nclass LichKhamDinhKy {\n  MaLich: int\n  MaBN: int\n  NgayGioHen: DateTime\n  TrangThai: string\n  --\n  DatLich()\n  DoiLich()\n  HuyLich()\n}\n\nclass ThanhToanVienPhi {\n  MaThanhToan: int\n  MaPhieuKham: int\n  SoTien: decimal\n  NgayThanhToan: Date\n  TrangThai: string\n  --\n  TinhVienPhi()\n  ThanhToan()\n  XacNhanThanhToan()\n}\n\n&#39; Association\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; DangKyKhamBenh\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; LePhiNam\nBenhNhan \&quot;1\&quot; -- \&quot;0..1\&quot; HoSoBenhAn\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; LichKhamDinhKy\n\nDangKyKhamBenh \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuKham\n\nKhoa \&quot;1\&quot; -- \&quot;0..*\&quot; BacSi\nKhoa \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham\nBacSi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham\n\nThuoc \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietToaThuoc\nPhieuKham \&quot;1\&quot; -- \&quot;0..1\&quot; ThanhToanVienPhi\n\n&#39; Composition\nHoSoBenhAn \&quot;1\&quot; *-- \&quot;0..*\&quot; PhieuKham\nPhieuKham \&quot;1\&quot; *-- \&quot;0..*\&quot; XetNghiem\nPhieuKham \&quot;1\&quot; *-- \&quot;0..1\&quot; ToaThuoc\nToaThuoc \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietToaThuoc\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="svOzgWSn15A--TTn3anu-385">
