        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC1 - DANG KY KHAM BENH\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Benh nhan\&quot; as BN\nactor \&quot;Nhan vien\&quot; as NV\n\nrectangle \&quot;HE THONG QUAN LY HO SO BENH AN\&quot; {\n\n  usecase \&quot;Dang ky kham benh\&quot; as UC1\n  usecase \&quot;Nhap thong tin benh nhan\&quot; as UC2\n  usecase \&quot;Kiem tra thong tin benh nhan\&quot; as UC3\n  usecase \&quot;Thu le phi nam\&quot; as UC4\n  usecase \&quot;Cap ho so benh an\&quot; as UC5\n  usecase \&quot;Tao phieu kham\&quot; as UC6\n\n}\n\nBN -- UC1\nNV -- UC1\nNV -- UC3\nNV -- UC4\nNV -- UC5\nNV -- UC6\n\nUC1 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC3 : &lt;&lt;include&gt;&gt;\nUC4 ..&gt; UC1 : &lt;&lt;extend&gt;&gt;\nUC5 ..&gt; UC4 : &lt;&lt;extend&gt;&gt;\nUC1 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\n\nnote right of UC4\n  Ap dung khi benh nhan\n  can dong le phi nam\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lV6iRNOo7w5fjmacxYCn-1">
