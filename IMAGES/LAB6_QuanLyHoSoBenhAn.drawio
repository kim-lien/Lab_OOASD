        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC8 - GHI NHAN TRIEU CHUNG\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Bac si\&quot; as BS\nactor \&quot;Benh nhan\&quot; as BN\n\nrectangle \&quot;HE THONG QUAN LY HO SO BENH AN\&quot; {\n\n  usecase \&quot;Ghi nhan trieu chung\&quot; as UC8\n  usecase \&quot;Tiep nhan thong tin trieu chung\&quot; as UC81\n  usecase \&quot;Kiem tra tinh trang suc khoe\&quot; as UC82\n  usecase \&quot;Ghi nhan than nhiet\&quot; as UC83\n  usecase \&quot;Ghi nhan huyet ap\&quot; as UC84\n  usecase \&quot;Ghi nhan cac trieu chung khac\&quot; as UC85\n  usecase \&quot;Nhap thong tin trieu chung\&quot; as UC86\n  usecase \&quot;Kiem tra thong tin da nhap\&quot; as UC87\n  usecase \&quot;Luu thong tin trieu chung\&quot; as UC88\n  usecase \&quot;Cap nhat trieu chung\&quot; as UC89\n\n}\n\nBS -- UC8\nBN -- UC8\n\nBS -- UC86\nBS -- UC89\n\nUC8 ..&gt; UC81 : &lt;&lt;include&gt;&gt;\nUC8 ..&gt; UC82 : &lt;&lt;include&gt;&gt;\nUC8 ..&gt; UC86 : &lt;&lt;include&gt;&gt;\nUC8 ..&gt; UC87 : &lt;&lt;include&gt;&gt;\nUC8 ..&gt; UC88 : &lt;&lt;include&gt;&gt;\n\nUC83 ..&gt; UC82 : &lt;&lt;extend&gt;&gt;\nUC84 ..&gt; UC82 : &lt;&lt;extend&gt;&gt;\nUC85 ..&gt; UC8 : &lt;&lt;extend&gt;&gt;\nUC89 ..&gt; UC8 : &lt;&lt;extend&gt;&gt;\n\nnote right of UC85\n  Thuc hien khi benh nhan\n  co cac trieu chung khac\n  nhu nhuc dau, ho, sot\nend note\n\nnote right of UC89\n  Thuc hien khi can\n  chinh sua hoac bo sung\n  thong tin trieu chung\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KhnMYgAfbm0gDm6oT-Hf-173">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
