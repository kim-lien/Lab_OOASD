        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC7 - KHAM BENH\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Bac si\&quot; as BS\nactor \&quot;Benh nhan\&quot; as BN\n\nrectangle \&quot;HE THONG QUAN LY HO SO BENH AN\&quot; {\n\n  usecase \&quot;Kham benh\&quot; as UC7\n  usecase \&quot;Tiep nhan phieu kham\&quot; as UC71\n  usecase \&quot;Tra cuu ho so benh an\&quot; as UC72\n  usecase \&quot;Kiem tra tinh trang suc khoe\&quot; as UC73\n  usecase \&quot;Ghi nhan trieu chung\&quot; as UC74\n  usecase \&quot;Do than nhiet va huyet ap\&quot; as UC75\n  usecase \&quot;Chan doan benh\&quot; as UC76\n  usecase \&quot;Chi dinh xet nghiem\&quot; as UC77\n  usecase \&quot;Xem ket qua xet nghiem\&quot; as UC78\n  usecase \&quot;Lap toa thuoc\&quot; as UC79\n  usecase \&quot;Cap nhat ket qua kham\&quot; as UC710\n\n}\n\nBS -- UC7\nBN -- UC7\n\nBS -- UC77\nBS -- UC78\nBS -- UC79\n\nUC7 ..&gt; UC71 : &lt;&lt;include&gt;&gt;\nUC7 ..&gt; UC72 : &lt;&lt;include&gt;&gt;\nUC7 ..&gt; UC73 : &lt;&lt;include&gt;&gt;\nUC7 ..&gt; UC74 : &lt;&lt;include&gt;&gt;\nUC7 ..&gt; UC76 : &lt;&lt;include&gt;&gt;\nUC7 ..&gt; UC710 : &lt;&lt;include&gt;&gt;\n\nUC75 ..&gt; UC73 : &lt;&lt;extend&gt;&gt;\nUC77 ..&gt; UC7 : &lt;&lt;extend&gt;&gt;\nUC78 ..&gt; UC7 : &lt;&lt;extend&gt;&gt;\nUC79 ..&gt; UC7 : &lt;&lt;extend&gt;&gt;\n\nnote right of UC77\n  Thuc hien khi bac si\n  can them ket qua\n  de chan doan\nend note\n\nnote right of UC79\n  Thuc hien khi\n  benh nhan can\n  dieu tri bang thuoc\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KhnMYgAfbm0gDm6oT-Hf-136">
