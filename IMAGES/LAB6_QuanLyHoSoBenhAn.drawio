        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC9 - CHAN DOAN BENH\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Bac si\&quot; as BS\nactor \&quot;Benh nhan\&quot; as BN\n\nrectangle \&quot;HE THONG QUAN LY HO SO BENH AN\&quot; {\n\n  usecase \&quot;Chan doan benh\&quot; as UC9\n  usecase \&quot;Tra cuu ho so benh an\&quot; as UC91\n  usecase \&quot;Xem trieu chung benh nhan\&quot; as UC92\n  usecase \&quot;Danh gia tinh trang suc khoe\&quot; as UC93\n  usecase \&quot;Xem ket qua xet nghiem\&quot; as UC94\n  usecase \&quot;Xac dinh benh\&quot; as UC95\n  usecase \&quot;Nhap ket qua chan doan\&quot; as UC96\n  usecase \&quot;Kiem tra ket qua chan doan\&quot; as UC97\n  usecase \&quot;Luu ket qua chan doan\&quot; as UC98\n  usecase \&quot;Cap nhat chan doan\&quot; as UC99\n\n}\n\nBS -- UC9\nBN -- UC9\n\nBS -- UC94\nBS -- UC96\nBS -- UC99\n\nUC9 ..&gt; UC91 : &lt;&lt;include&gt;&gt;\nUC9 ..&gt; UC92 : &lt;&lt;include&gt;&gt;\nUC9 ..&gt; UC93 : &lt;&lt;include&gt;&gt;\nUC9 ..&gt; UC95 : &lt;&lt;include&gt;&gt;\nUC9 ..&gt; UC96 : &lt;&lt;include&gt;&gt;\nUC9 ..&gt; UC97 : &lt;&lt;include&gt;&gt;\nUC9 ..&gt; UC98 : &lt;&lt;include&gt;&gt;\n\nUC94 ..&gt; UC9 : &lt;&lt;extend&gt;&gt;\nUC99 ..&gt; UC9 : &lt;&lt;extend&gt;&gt;\n\nnote right of UC94\n  Thuc hien khi benh nhan\n  co ket qua xet nghiem\nend note\n\nnote right of UC99\n  Thuc hien khi can\n  chinh sua hoac bo sung\n  ket qua chan doan\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KhnMYgAfbm0gDm6oT-Hf-208">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
