      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle ACTIVITY DIAGRAM - DANG KY KHAM BENH\n\n|Benh nhan|\nstart\n:Den benh vien dang ky kham;\n:Cung cap thong tin ca nhan;\n\n|Nhan vien|\n:Tiep nhan yeu cau dang ky;\n:Nhap thong tin tim kiem;\n\n|He thong|\n:Kiem tra thong tin benh nhan;\n\nif (Benh nhan da co ho so?) then (Co)\n  :Tra cuu ho so benh an;\n\nelse (Chua)\n  |Nhan vien|\n  :Nhap thong tin benh nhan moi;\n\n  |He thong|\n  :Kiem tra tinh hop le thong tin;\n\n  if (Thong tin hop le?) then (Co)\n    :Luu thong tin benh nhan;\n\n    |Nhan vien|\n    :Thong bao le phi nam;\n\n    |Benh nhan|\n    :Thanh toan le phi nam;\n\n    |Nhan vien|\n    :Xac nhan thanh toan;\n\n    |He thong|\n    if (Thanh toan thanh cong?) then (Co)\n      :Ghi nhan le phi nam;\n      :Tao ma ho so benh an;\n      :Cap ho so benh an;\n    else (Khong)\n      :Thong bao thanh toan that bai;\n      stop\n    endif\n\n  else (Khong)\n    :Thong bao thong tin khong hop le;\n    stop\n  endif\nendif\n\n|Nhan vien|\n:Chon khoa kham benh;\n:Phan cong bac si;\n:Nhap ngay gio kham;\n\n|He thong|\n:Tao phieu kham;\n:Luu thong tin dang ky;\n:Thong bao dang ky thanh cong;\n\n|Benh nhan|\n:Nhan thong tin phieu kham;\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="o8spvxiHmKO46t7eJB9i-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
