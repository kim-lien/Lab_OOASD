          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC14 - LAP TOA THUOC\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Bac si\&quot; as BS\nactor \&quot;Benh nhan\&quot; as BN\n\nrectangle \&quot;HE THONG QUAN LY HO SO BENH AN\&quot; {\n\n  usecase \&quot;Lap toa thuoc\&quot; as UC14\n  usecase \&quot;Tra cuu phieu kham\&quot; as UC141\n  usecase \&quot;Xem ket qua chan doan\&quot; as UC142\n  usecase \&quot;Xem ket qua xet nghiem\&quot; as UC143\n  usecase \&quot;Kiem tra lich su dung thuoc\&quot; as UC144\n  usecase \&quot;Chon thuoc dieu tri\&quot; as UC145\n  usecase \&quot;Nhap so luong thuoc\&quot; as UC146\n  usecase \&quot;Nhap lieu dung va cach dung\&quot; as UC147\n  usecase \&quot;Kiem tra thong tin toa thuoc\&quot; as UC148\n  usecase \&quot;Luu toa thuoc\&quot; as UC149\n  usecase \&quot;Xac nhan toa thuoc\&quot; as UC1410\n  usecase \&quot;In toa thuoc\&quot; as UC1411\n  usecase \&quot;Cap nhat toa thuoc\&quot; as UC1412\n\n}\n\nBS -- UC14\nBS -- UC145\nBS -- UC1410\nBS -- UC1412\n\nBN -- UC1411\n\nUC14 ..&gt; UC141 : &lt;&lt;include&gt;&gt;\nUC14 ..&gt; UC142 : &lt;&lt;include&gt;&gt;\nUC14 ..&gt; UC144 : &lt;&lt;include&gt;&gt;\nUC14 ..&gt; UC145 : &lt;&lt;include&gt;&gt;\nUC14 ..&gt; UC146 : &lt;&lt;include&gt;&gt;\nUC14 ..&gt; UC147 : &lt;&lt;include&gt;&gt;\nUC14 ..&gt; UC148 : &lt;&lt;include&gt;&gt;\nUC14 ..&gt; UC149 : &lt;&lt;include&gt;&gt;\nUC14 ..&gt; UC1410 : &lt;&lt;include&gt;&gt;\n\nUC143 ..&gt; UC14 : &lt;&lt;extend&gt;&gt;\nUC1411 ..&gt; UC14 : &lt;&lt;extend&gt;&gt;\nUC1412 ..&gt; UC14 : &lt;&lt;extend&gt;&gt;\n\nnote right of UC143\n  Thuc hien khi benh nhan\n  co ket qua xet nghiem\nend note\n\nnote right of UC1411\n  Thuc hien khi can\n  in toa thuoc cho benh nhan\nend note\n\nnote right of UC1412\n  Thuc hien khi bac si\n  can chinh sua toa thuoc\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KhnMYgAfbm0gDm6oT-Hf-385">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
