        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle ACTIVITY DIAGRAM - CAP HO SO BENH AN\n\n|Nhan vien|\nstart\n:Tiep nhan yeu cau cap ho so;\n:Nhap thong tin benh nhan;\n\n|He thong|\n:Kiem tra thong tin benh nhan;\n:Kiem tra tinh trang dong le phi nam;\n\nif (Da dong le phi nam?) then (Co)\n  :Kiem tra ho so benh an da ton tai;\n\n  if (Ho so da ton tai?) then (Co)\n    :Thong bao ho so da ton tai;\n\n    |Nhan vien|\n    :Huong dan su dung ho so hien co;\n\n  else (Chua)\n    |He thong|\n    :Tao ma ho so benh an;\n    :Lap ho so benh an;\n    :Luu thong tin ho so;\n\n    |Nhan vien|\n    if (Can in ho so?) then (Co)\n      :In ho so benh an;\n    else (Khong)\n    endif\n\n    :Ban giao ho so benh an;\n\n    |Benh nhan|\n    :Tiep nhan ho so benh an;\n  endif\n\nelse (Chua)\n  :Thong bao chua dong le phi nam;\n\n  |Nhan vien|\n  :Huong dan hoan tat le phi;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="o8spvxiHmKO46t7eJB9i-200">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
