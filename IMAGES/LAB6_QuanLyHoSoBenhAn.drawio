        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC11 - THUC HIEN XET NGHIEM\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Benh nhan\&quot; as BN\nactor \&quot;Nhan vien xet nghiem\&quot; as NVXN\n\nrectangle \&quot;HE THONG QUAN LY HO SO BENH AN\&quot; {\n\n  usecase \&quot;Thuc hien xet nghiem\&quot; as UC11\n  usecase \&quot;Tiep nhan yeu cau xet nghiem\&quot; as UC111\n  usecase \&quot;Tra cuu phieu chi dinh\&quot; as UC112\n  usecase \&quot;Kiem tra thong tin benh nhan\&quot; as UC113\n  usecase \&quot;Kiem tra loai xet nghiem\&quot; as UC114\n  usecase \&quot;Lay mau xet nghiem\&quot; as UC115\n  usecase \&quot;Tien hanh xet nghiem\&quot; as UC116\n  usecase \&quot;Ghi nhan ket qua xet nghiem\&quot; as UC117\n  usecase \&quot;Cap nhat trang thai xet nghiem\&quot; as UC118\n  usecase \&quot;Thong bao hoan thanh xet nghiem\&quot; as UC119\n\n}\n\nBN -- UC11\nBN -- UC115\n\nNVXN -- UC11\nNVXN -- UC111\nNVXN -- UC115\nNVXN -- UC116\nNVXN -- UC117\n\nUC11 ..&gt; UC111 : &lt;&lt;include&gt;&gt;\nUC11 ..&gt; UC112 : &lt;&lt;include&gt;&gt;\nUC11 ..&gt; UC113 : &lt;&lt;include&gt;&gt;\nUC11 ..&gt; UC114 : &lt;&lt;include&gt;&gt;\nUC11 ..&gt; UC116 : &lt;&lt;include&gt;&gt;\nUC11 ..&gt; UC117 : &lt;&lt;include&gt;&gt;\nUC11 ..&gt; UC118 : &lt;&lt;include&gt;&gt;\nUC11 ..&gt; UC119 : &lt;&lt;include&gt;&gt;\n\nUC115 ..&gt; UC11 : &lt;&lt;extend&gt;&gt;\n\nnote right of UC115\n  Thuc hien khi loai\n  xet nghiem yeu cau\n  lay mau benh pham\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KhnMYgAfbm0gDm6oT-Hf-276">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
