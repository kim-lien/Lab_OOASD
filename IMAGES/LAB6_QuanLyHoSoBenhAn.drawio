        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC10 - CHI DINH XET NGHIEM\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Bac si\&quot; as BS\nactor \&quot;Benh nhan\&quot; as BN\n\nrectangle \&quot;HE THONG QUAN LY HO SO BENH AN\&quot; {\n\n  usecase \&quot;Chi dinh xet nghiem\&quot; as UC10\n  usecase \&quot;Tra cuu phieu kham\&quot; as UC101\n  usecase \&quot;Xem trieu chung benh nhan\&quot; as UC102\n  usecase \&quot;Danh gia nhu cau xet nghiem\&quot; as UC103\n  usecase \&quot;Chon loai xet nghiem\&quot; as UC104\n  usecase \&quot;Lap phieu chi dinh xet nghiem\&quot; as UC105\n  usecase \&quot;Kiem tra thong tin chi dinh\&quot; as UC106\n  usecase \&quot;Luu phieu chi dinh\&quot; as UC107\n  usecase \&quot;Thong bao cho benh nhan\&quot; as UC108\n  usecase \&quot;Cap nhat chi dinh xet nghiem\&quot; as UC109\n\n}\n\nBS -- UC10\nBN -- UC10\n\nBS -- UC104\nBS -- UC105\nBS -- UC109\n\nUC10 ..&gt; UC101 : &lt;&lt;include&gt;&gt;\nUC10 ..&gt; UC102 : &lt;&lt;include&gt;&gt;\nUC10 ..&gt; UC103 : &lt;&lt;include&gt;&gt;\nUC10 ..&gt; UC104 : &lt;&lt;include&gt;&gt;\nUC10 ..&gt; UC105 : &lt;&lt;include&gt;&gt;\nUC10 ..&gt; UC106 : &lt;&lt;include&gt;&gt;\nUC10 ..&gt; UC107 : &lt;&lt;include&gt;&gt;\nUC10 ..&gt; UC108 : &lt;&lt;include&gt;&gt;\n\nUC109 ..&gt; UC10 : &lt;&lt;extend&gt;&gt;\n\nnote right of UC109\n  Thuc hien khi can\n  chinh sua hoac bo sung\n  chi dinh xet nghiem\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KhnMYgAfbm0gDm6oT-Hf-243">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
