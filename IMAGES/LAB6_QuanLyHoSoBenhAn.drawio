        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle ACTIVITY DIAGRAM - DANG KY KHAM DEN NHAN TOA THUOC\n\n|Benh nhan|\nstart\n:Den benh vien yeu cau kham;\n:Cung cap thong tin ca nhan / ma ho so;\n\n|Nhan vien|\n:Tiep nhan yeu cau kham;\n:Nhap thong tin tra cuu;\n\n|He thong|\n:Tim kiem ho so benh an;\n\nif (Da co ho so?) then (Co)\n  :Hien thi ho so benh an;\nelse (Chua)\n  |Nhan vien|\n  :Lap phieu dang ky lan dau;\n  :Kiem tra thong tin dang ky;\n\n  |He thong|\n  if (Thong tin hop le?) then (Co)\n    |Benh nhan|\n    :Dong le phi nam;\n\n    |Nhan vien|\n    :Tiep nhan va xac nhan thanh toan;\n\n    |He thong|\n    if (Thanh toan thanh cong?) then (Co)\n      :Ghi nhan le phi nam;\n      :Tao va luu ho so benh an;\n    else (Khong)\n      :Thong bao chua hoan tat le phi;\n      stop\n    endif\n  else (Khong)\n    :Thong bao thong tin khong hop le;\n    stop\n  endif\nendif\n\n|Nhan vien|\n:Chon khoa va bac si;\n:Tao phieu kham;\n\n|He thong|\n:Luu phieu kham vao ho so;\n\n|Benh nhan|\n:Den phong kham;\n\n|Bac si|\n:Tiep nhan phieu kham;\n:Tra cuu lich su benh an;\n:Kham va ghi nhan trieu chung;\n:Do than nhiet, huyet ap;\n\nif (Can xet nghiem?) then (Co)\n  :Chi dinh xet nghiem;\n\n  |He thong|\n  :Tao phieu chi dinh xet nghiem;\n\n  |Benh nhan|\n  :Den bo phan xet nghiem;\n\n  |Nhan vien xet nghiem|\n  :Tiep nhan yeu cau xet nghiem;\n  :Thuc hien xet nghiem;\n  :Cap nhat ket qua;\n\n  |He thong|\n  :Luu ket qua gan voi phieu kham;\n\n  |Bac si|\n  :Xem ket qua xet nghiem;\nelse (Khong)\nendif\n\n:Ghi nhan chan doan;\n\nif (Can ke toa thuoc?) then (Co)\n  :Xem thong tin phieu kham;\n\n  repeat\n    :Chon thuoc;\n    :Nhap so luong, lieu dung,\n    cach dung;\n  repeat while (Them thuoc khac?) is (Co) not (Khong)\n\n  :Ghi loi dan neu co;\n  :Xac nhan toa thuoc;\n\n  |He thong|\n  :Luu toa thuoc va chi tiet thuoc;\n  :Lien ket toa voi phieu kham;\n\n  |Bac si|\n  :In / xuat toa va huong dan su dung;\n\n  |Benh nhan|\n  :Nhan toa thuoc;\nelse (Khong)\n  |Benh nhan|\n  :Nhan ket luan kham;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zHvHe8nEx-ZexKWHNImO-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
