      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle SEQUENCE DIAGRAM - LAP TOA THUOC\n\nautonumber\nskinparam shadowing false\nskinparam sequenceMessageAlign center\n\nactor \&quot;Bac si\&quot; as BS\nboundary \&quot;Giao dien lap toa\&quot; as GD\ncontrol \&quot;Xu ly toa thuoc\&quot; as XL\nentity \&quot;Phieu kham\&quot; as PK\nentity \&quot;Thuoc\&quot; as TH\nentity \&quot;Toa thuoc\&quot; as TT\nentity \&quot;Chi tiet toa thuoc\&quot; as CT\n\nBS -&gt; GD : Chon chuc nang lap toa\nactivate GD\n\nGD -&gt; BS : Yeu cau nhap ma phieu kham\nBS -&gt; GD : Nhap ma phieu kham\n\nGD -&gt; XL : Yeu cau tra cuu phieu kham\nactivate XL\n\nXL -&gt; PK : Tim kiem phieu kham\nactivate PK\nPK --&gt; XL : Tra ket qua tim kiem\ndeactivate PK\n\nalt Tim thay phieu kham\n\n    XL --&gt; GD : Thong tin phieu kham\n    deactivate XL\n\n    GD --&gt; BS : Hien thi thong tin chan doan\n\n    BS -&gt; GD : Yeu cau xem danh muc thuoc\n\n    GD -&gt; XL : Lay danh sach thuoc\n    activate XL\n\n    XL -&gt; TH : Tim kiem thuoc\n    activate TH\n    TH --&gt; XL : Danh sach thuoc\n    deactivate TH\n\n    XL --&gt; GD : Tra danh sach thuoc\n    deactivate XL\n\n    GD --&gt; BS : Hien thi danh sach thuoc\n\n    loop Them tung loai thuoc\n        BS -&gt; GD : Chon thuoc va nhap lieu dung\n\n        GD -&gt; XL : Kiem tra chi tiet thuoc\n        activate XL\n\n        XL -&gt; XL : Kiem tra thong tin thuoc\n        XL --&gt; GD : Ket qua kiem tra\n        deactivate XL\n    end\n\n    BS -&gt; GD : Xac nhan lap toa\n\n    GD -&gt; XL : Gui thong tin toa thuoc\n    activate XL\n\n    XL -&gt; XL : Kiem tra tinh hop le\n\n    alt Thong tin hop le\n\n        XL -&gt; TT : Tao va luu toa thuoc\n        activate TT\n        TT --&gt; XL : Tra ma toa thuoc\n        deactivate TT\n\n        loop Luu tung chi tiet thuoc\n            XL -&gt; CT : Luu chi tiet toa thuoc\n            activate CT\n            CT --&gt; XL : Xac nhan luu\n            deactivate CT\n        end\n\n        XL --&gt; GD : Lap toa thanh cong\n        deactivate XL\n\n        GD --&gt; BS : Hien thi toa thuoc da lap\n\n    else Thong tin khong hop le\n\n        XL --&gt; GD : Thong bao loi\n        deactivate XL\n\n        GD --&gt; BS : Yeu cau chinh sua\n    end\n\nelse Khong tim thay phieu kham\n\n    XL --&gt; GD : Thong bao khong tim thay\n    deactivate XL\n\n    GD --&gt; BS : Yeu cau kiem tra lai\nend\n\ndeactivate GD\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="GmNdMh-BRnBAfjargt2v-72">
