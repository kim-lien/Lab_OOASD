        <UserObject label="UC11 - THUC HIEN XET NGHIEM" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="UC11 - THUC HIEN XET NGHIEM" id="KhnMYgAfbm0gDm6oT-Hf-310">
          <mxCell parent="KhnMYgAfbm0gDm6oT-Hf-276" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1">
            <mxGeometry height="24" width="242" x="377" y="6660" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC12 - CAP NHAT KET QUA XET NGHIEM\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Nhan vien xet nghiem\&quot; as NVXN\nactor \&quot;Bac si\&quot; as BS\n\nrectangle \&quot;HE THONG QUAN LY HO SO BENH AN\&quot; {\n\n  usecase \&quot;Cap nhat ket qua xet nghiem\&quot; as UC12\n  usecase \&quot;Tra cuu phieu xet nghiem\&quot; as UC121\n  usecase \&quot;Kiem tra thong tin benh nhan\&quot; as UC122\n  usecase \&quot;Nhap ket qua xet nghiem\&quot; as UC123\n  usecase \&quot;Kiem tra ket qua xet nghiem\&quot; as UC124\n  usecase \&quot;Luu ket qua xet nghiem\&quot; as UC125\n  usecase \&quot;Cap nhat trang thai xet nghiem\&quot; as UC126\n  usecase \&quot;Thong bao ket qua cho bac si\&quot; as UC127\n  usecase \&quot;Chinh sua ket qua xet nghiem\&quot; as UC128\n  usecase \&quot;In ket qua xet nghiem\&quot; as UC129\n\n}\n\nNVXN -- UC12\nNVXN -- UC123\nNVXN -- UC128\nNVXN -- UC129\n\nBS -- UC127\n\nUC12 ..&gt; UC121 : &lt;&lt;include&gt;&gt;\nUC12 ..&gt; UC122 : &lt;&lt;include&gt;&gt;\nUC12 ..&gt; UC123 : &lt;&lt;include&gt;&gt;\nUC12 ..&gt; UC124 : &lt;&lt;include&gt;&gt;\nUC12 ..&gt; UC125 : &lt;&lt;include&gt;&gt;\nUC12 ..&gt; UC126 : &lt;&lt;include&gt;&gt;\nUC12 ..&gt; UC127 : &lt;&lt;include&gt;&gt;\n\nUC128 ..&gt; UC12 : &lt;&lt;extend&gt;&gt;\nUC129 ..&gt; UC12 : &lt;&lt;extend&gt;&gt;\n\nnote right of UC128\n  Thuc hien khi ket qua\n  bi sai hoac can bo sung\nend note\n\nnote right of UC129\n  Thuc hien khi can\n  in ket qua xet nghiem\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KhnMYgAfbm0gDm6oT-Hf-311">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
