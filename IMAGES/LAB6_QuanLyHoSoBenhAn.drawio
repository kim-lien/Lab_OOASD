        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC5 - TAO PHIEU KHAM\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Benh nhan\&quot; as BN\nactor \&quot;Nhan vien\&quot; as NV\n\nrectangle \&quot;HE THONG QUAN LY HO SO BENH AN\&quot; {\n\n  usecase \&quot;Tao phieu kham\&quot; as UC5\n  usecase \&quot;Tiep nhan yeu cau kham\&quot; as UC51\n  usecase \&quot;Tra cuu ho so benh an\&quot; as UC52\n  usecase \&quot;Kiem tra thong tin benh nhan\&quot; as UC53\n  usecase \&quot;Chon khoa kham benh\&quot; as UC54\n  usecase \&quot;Phan cong bac si kham\&quot; as UC55\n  usecase \&quot;Nhap ngay gio kham\&quot; as UC56\n  usecase \&quot;Luu phieu kham\&quot; as UC57\n  usecase \&quot;In phieu kham\&quot; as UC58\n\n}\n\nBN -- UC5\nBN -- UC51\n\nNV -- UC5\nNV -- UC52\nNV -- UC54\nNV -- UC55\nNV -- UC58\n\nUC5 ..&gt; UC51 : &lt;&lt;include&gt;&gt;\nUC5 ..&gt; UC52 : &lt;&lt;include&gt;&gt;\nUC5 ..&gt; UC53 : &lt;&lt;include&gt;&gt;\nUC5 ..&gt; UC54 : &lt;&lt;include&gt;&gt;\nUC5 ..&gt; UC55 : &lt;&lt;include&gt;&gt;\nUC5 ..&gt; UC56 : &lt;&lt;include&gt;&gt;\nUC5 ..&gt; UC57 : &lt;&lt;include&gt;&gt;\n\nUC58 ..&gt; UC5 : &lt;&lt;extend&gt;&gt;\n\nnote right of UC52\n  Benh nhan phai co\n  ho so benh an\nend note\n\nnote right of UC58\n  Thuc hien khi\n  can in phieu kham\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KhnMYgAfbm0gDm6oT-Hf-66">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
