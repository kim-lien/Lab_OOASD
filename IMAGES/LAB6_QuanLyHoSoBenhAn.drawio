        <UserObject label="UC13 - XEM KET QUA XET NGHIEM" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="UC13 - XEM KET QUA XET NGHIEM" id="KhnMYgAfbm0gDm6oT-Hf-383">
          <mxCell parent="KhnMYgAfbm0gDm6oT-Hf-348" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1">
