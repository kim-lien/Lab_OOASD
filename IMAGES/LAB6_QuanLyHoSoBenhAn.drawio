        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC16 - NHAN TOA THUOC\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Benh nhan\&quot; as BN\nactor \&quot;Bac si\&quot; as BS\n\nrectangle \&quot;HE THONG QUAN LY HO SO BENH AN\&quot; {\n\n  usecase \&quot;Nhan toa thuoc\&quot; as UC16\n  usecase \&quot;Tra cuu phieu kham\&quot; as UC161\n  usecase \&quot;Kiem tra toa thuoc\&quot; as UC162\n  usecase \&quot;Xac nhan toa thuoc da lap\&quot; as UC163\n  usecase \&quot;Hien thi thong tin toa thuoc\&quot; as UC164\n  usecase \&quot;Xem chi tiet thuoc\&quot; as UC165\n  usecase \&quot;Huong dan su dung thuoc\&quot; as UC166\n  usecase \&quot;In toa thuoc\&quot; as UC167\n  usecase \&quot;Ban giao toa thuoc\&quot; as UC168\n  usecase \&quot;Xac nhan da nhan toa thuoc\&quot; as UC169\n  usecase \&quot;Thong bao chua co toa thuoc\&quot; as UC1610\n\n}\n\nBN -- UC16\nBN -- UC165\nBN -- UC169\n\nBS -- UC16\nBS -- UC163\nBS -- UC166\nBS -- UC168\n\nUC16 ..&gt; UC161 : &lt;&lt;include&gt;&gt;\nUC16 ..&gt; UC162 : &lt;&lt;include&gt;&gt;\nUC16 ..&gt; UC163 : &lt;&lt;include&gt;&gt;\nUC16 ..&gt; UC164 : &lt;&lt;include&gt;&gt;\nUC16 ..&gt; UC165 : &lt;&lt;include&gt;&gt;\nUC16 ..&gt; UC166 : &lt;&lt;include&gt;&gt;\nUC16 ..&gt; UC168 : &lt;&lt;include&gt;&gt;\nUC16 ..&gt; UC169 : &lt;&lt;include&gt;&gt;\n\nUC167 ..&gt; UC16 : &lt;&lt;extend&gt;&gt;\nUC1610 ..&gt; UC16 : &lt;&lt;extend&gt;&gt;\n\nnote right of UC167\n  Thuc hien khi benh nhan\n  can nhan toa thuoc\n  bang ban in\nend note\n\nnote right of UC1610\n  Thuc hien khi\n  chua co toa thuoc\n  duoc lap\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KhnMYgAfbm0gDm6oT-Hf-467">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
