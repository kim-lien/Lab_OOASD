        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle ACTIVITY DIAGRAM - TAO PHIEU KHAM\n\n|Benh nhan|\nstart\n:Yeu cau tao phieu kham;\n:Cung cap ma ho so benh an;\n\n|Nhan vien|\n:Tiep nhan yeu cau kham;\n:Nhap thong tin tim kiem;\n\n|He thong|\n:Tra cuu ho so benh an;\n\nif (Tim thay ho so?) then (Co)\n  :Hien thi thong tin benh nhan;\n\n  |Nhan vien|\n  :Kiem tra thong tin benh nhan;\n\n  if (Thong tin chinh xac?) then (Co)\n    :Chon khoa kham benh;\n    :Phan cong bac si;\n    :Nhap ngay gio kham;\n\n    |He thong|\n    :Kiem tra thong tin phieu kham;\n\n    if (Thong tin hop le?) then (Co)\n      :Tao ma phieu kham;\n      :Tao phieu kham;\n      :Lien ket voi ho so benh an;\n      :Luu phieu kham;\n\n      |Nhan vien|\n      if (Can in phieu kham?) then (Co)\n        :In phieu kham;\n      else (Khong)\n      endif\n\n      :Thong bao tao phieu thanh cong;\n\n      |Benh nhan|\n      :Nhan thong tin phieu kham;\n\n    else (Khong)\n      :Thong bao thong tin khong hop le;\n    endif\n\n  else (Khong)\n    :Yeu cau kiem tra lai thong tin;\n  endif\n\nelse (Khong)\n  :Thong bao khong tim thay ho so;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="o8spvxiHmKO46t7eJB9i-260">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
