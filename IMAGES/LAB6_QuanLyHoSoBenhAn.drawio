        <UserObject label="ACTIVITY DIAGRAM - KIEM TRA THONG TIN BENH NHAN" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="ACTIVITY DIAGRAM - KIEM TRA THONG TIN BENH NHAN" id="o8spvxiHmKO46t7eJB9i-123">
          <mxCell parent="o8spvxiHmKO46t7eJB9i-77" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1">
            <mxGeometry height="24" width="419" x="349.5" y="1630" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle ACTIVITY DIAGRAM - THU LE PHI NAM\n\n|Nhan vien|\nstart\n:Tiep nhan yeu cau dong le phi;\n:Nhap thong tin benh nhan;\n\n|He thong|\n:Tra cuu thong tin benh nhan;\n:Kiem tra tinh trang dong phi;\n\nif (Da dong le phi nam?) then (Co)\n  :Thong bao da hoan thanh le phi;\nelse (Chua)\n  :Xac dinh so tien le phi;\n\n  |Nhan vien|\n  :Thong bao so tien can dong;\n\n  |Benh nhan|\n  :Tiep nhan thong tin le phi;\n\n  if (Dong y thanh toan?) then (Co)\n    :Thuc hien thanh toan;\n\n    |Nhan vien|\n    :Tiep nhan thanh toan;\n    :Xac nhan giao dich;\n\n    |He thong|\n    if (Thanh toan thanh cong?) then (Co)\n      :Luu thong tin dong le phi;\n      :Cap nhat trang thai le phi;\n\n      if (Can in bien lai?) then (Co)\n        :Tao bien lai thu phi;\n\n        |Nhan vien|\n        :In va giao bien lai;\n\n        |He thong|\n      endif\n\n      :Thong bao thanh toan thanh cong;\n    else (Khong)\n      :Thong bao thanh toan that bai;\n    endif\n\n  else (Khong)\n    |He thong|\n    :Thong bao chua thanh toan;\n  endif\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="o8spvxiHmKO46t7eJB9i-126">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
