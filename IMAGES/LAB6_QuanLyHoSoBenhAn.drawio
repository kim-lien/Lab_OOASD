        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC13 - XEM KET QUA XET NGHIEM\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\n\nactor \&quot;Bac si\&quot; as BS\nactor \&quot;Nhan vien xet nghiem\&quot; as NVXN\n\nrectangle \&quot;HE THONG QUAN LY HO SO BENH AN\&quot; {\n\n  usecase \&quot;Xem ket qua xet nghiem\&quot; as UC13\n  usecase \&quot;Tra cuu phieu kham\&quot; as UC131\n  usecase \&quot;Tim kiem phieu xet nghiem\&quot; as UC132\n  usecase \&quot;Kiem tra trang thai xet nghiem\&quot; as UC133\n  usecase \&quot;Hien thi ket qua xet nghiem\&quot; as UC134\n  usecase \&quot;Xem chi tiet ket qua\&quot; as UC135\n  usecase \&quot;So sanh ket qua xet nghiem\&quot; as UC136\n  usecase \&quot;Xem lich su xet nghiem\&quot; as UC137\n  usecase \&quot;In ket qua xet nghiem\&quot; as UC138\n  usecase \&quot;Thong bao chua co ket qua\&quot; as UC139\n\n}\n\nBS -- UC13\nBS -- UC135\nBS -- UC136\nBS -- UC137\nBS -- UC138\n\nNVXN -- UC13\n\nUC13 ..&gt; UC131 : &lt;&lt;include&gt;&gt;\nUC13 ..&gt; UC132 : &lt;&lt;include&gt;&gt;\nUC13 ..&gt; UC133 : &lt;&lt;include&gt;&gt;\n\nUC134 ..&gt; UC13 : &lt;&lt;extend&gt;&gt;\nUC135 ..&gt; UC13 : &lt;&lt;extend&gt;&gt;\nUC136 ..&gt; UC13 : &lt;&lt;extend&gt;&gt;\nUC137 ..&gt; UC13 : &lt;&lt;extend&gt;&gt;\nUC138 ..&gt; UC13 : &lt;&lt;extend&gt;&gt;\nUC139 ..&gt; UC13 : &lt;&lt;extend&gt;&gt;\n\nnote right of UC134\n  Thuc hien khi\n  da co ket qua xet nghiem\nend note\n\nnote right of UC139\n  Thuc hien khi\n  chua co ket qua xet nghiem\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KhnMYgAfbm0gDm6oT-Hf-348">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
