        <UserObject label="Activity Diagram - Quy trình đặt hàng" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="Activity Diagram - Quy trình đặt hàng" id="CNitgtTzQHGro8eLsCAe-272">
