        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Sequence Diagram - Đăng nhập\n\nskinparam linetype ortho\nskinparam shadowing false\nskinparam sequenceMessageAlign center\nskinparam responseMessageBelowArrow true\n\nactor \&quot;Khách hàng\&quot; as KH\nboundary \&quot;FrmDangNhap\&quot; as Form\ncontrol \&quot;KhachHangService\&quot; as Service\ndatabase \&quot;SQL Server\&quot; as DB\n\nKH -&gt; Form : Nhập tên đăng nhập và mật khẩu\nKH -&gt; Form : Nhấn Đăng nhập\n\nactivate Form\nForm -&gt; Service : DangNhap(username, password)\nactivate Service\n\nService -&gt; DB : Kiểm tra tài khoản\nactivate DB\nDB --&gt; Service : Kết quả kiểm tra\ndeactivate DB\n\nalt Thông tin hợp lệ\n    Service --&gt; Form : Đăng nhập thành công\n    Form --&gt; KH : Mở FrmSanPham\nelse Thông tin không hợp lệ\n    Service --&gt; Form : Đăng nhập thất bại\n    Form --&gt; KH : Hiển thị thông báo lỗi\nend\n\ndeactivate Service\ndeactivate Form\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CNitgtTzQHGro8eLsCAe-54">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
