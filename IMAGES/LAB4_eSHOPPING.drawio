        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\nskinparam linetype ortho\nskinparam shadowing false\nskinparam packageStyle rectangle\nskinparam actorStyle stickman\nskinparam usecase {\n  BackgroundColor White\n  BorderColor Black\n}\nskinparam nodesep 35\nskinparam ranksep 45\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Hệ thống quản lý\\nsản phẩm\&quot; as QLSP\nactor \&quot;Dịch vụ thanh toán\\ntrực tuyến\&quot; as DVTT\nactor \&quot;Dịch vụ Email\&quot; as EMAIL\n\nrectangle \&quot;Hệ thống e-SHOPPING\&quot; {\n  usecase \&quot;Xem nhóm sản phẩm\&quot; as UC1\n  usecase \&quot;Xem sản phẩm\&quot; as UC2\n  usecase \&quot;Xem chi tiết sản phẩm\&quot; as UC3\n  usecase \&quot;Thêm sản phẩm vào giỏ\&quot; as UC4\n  usecase \&quot;Xem giỏ hàng\&quot; as UC5\n  usecase \&quot;Cập nhật giỏ hàng\&quot; as UC6\n  usecase \&quot;Xóa sản phẩm khỏi giỏ\&quot; as UC7\n  usecase \&quot;Đăng ký tài khoản\&quot; as UC8\n  usecase \&quot;Đăng nhập\&quot; as UC9\n  usecase \&quot;Đặt hàng\&quot; as UC10\n  usecase \&quot;Nhập thông tin người nhận\&quot; as UC11\n  usecase \&quot;Chọn phương thức giao hàng\&quot; as UC12\n  usecase \&quot;Tính phí giao hàng\&quot; as UC13\n  usecase \&quot;Thanh toán\&quot; as UC14\n  usecase \&quot;Kiểm tra thẻ\&quot; as UC15\n  usecase \&quot;Xác nhận đơn hàng\&quot; as UC16\n  usecase \&quot;Gửi email xác nhận\&quot; as UC17\n}\n\nKH -- UC1\nKH -- UC2\nKH -- UC3\nKH -- UC4\nKH -- UC5\nKH -- UC6\nKH -- UC7\nKH -- UC8\nKH -- UC9\nKH -- UC10\nKH -- UC14\n\nQLSP -- UC1\nQLSP -- UC2\nQLSP -- UC3\n\nDVTT -- UC15\nEMAIL -- UC17\n\nUC10 ..&gt; UC9 : &lt;&lt;include&gt;&gt;\nUC10 ..&gt; UC11 : &lt;&lt;include&gt;&gt;\nUC10 ..&gt; UC12 : &lt;&lt;include&gt;&gt;\nUC10 ..&gt; UC13 : &lt;&lt;include&gt;&gt;\nUC10 ..&gt; UC14 : &lt;&lt;include&gt;&gt;\n\nUC14 ..&gt; UC15 : &lt;&lt;include&gt;&gt;\nUC14 ..&gt; UC16 : &lt;&lt;include&gt;&gt;\nUC16 ..&gt; UC17 : &lt;&lt;include&gt;&gt;\