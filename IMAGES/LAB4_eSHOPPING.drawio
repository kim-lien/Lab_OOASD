        <UserObject label="Sequence Diagram - Thêm sản phẩm vào giỏ" plantUmlId="title_35" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sequence Diagram - Thêm sản phẩm vào giỏ" id="CNitgtTzQHGro8eLsCAe-183">
          <mxCell parent="CNitgtTzQHGro8eLsCAe-147" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="334.87839999999994" x="248.78843571428575" y="2970" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Activity Diagram - Quy trình đặt hàng\n\nskinparam linetype ortho\nskinparam shadowing false\nskinparam activity {\n  BackgroundColor White\n  BorderColor Black\n  DiamondBackgroundColor White\n  DiamondBorderColor Black\n  ArrowColor Black\n}\n\nstart\n\n:Xem danh sách sản phẩm;\n:Chọn sản phẩm;\n:Thêm sản phẩm vào giỏ;\n:Xem giỏ hàng;\n\nwhile (Tiếp tục mua hàng?) is (Có)\n    :Quay lại danh sách sản phẩm;\n    :Chọn thêm sản phẩm;\n    :Thêm vào giỏ hàng;\n    :Xem giỏ hàng;\nendwhile (Không)\n\n:Tiến hành đặt hàng;\n:Kiểm tra trạng thái đăng nhập;\n\nif (Đã đăng nhập?) then (Có)\nelse (Chưa)\n    if (Có tài khoản?) then (Có)\n        :Đăng nhập;\n    else (Không)\n        :Đăng ký tài khoản;\n        :Đăng nhập;\n    endif\nendif\n\n:Nhập thông tin người nhận;\n:Chọn phương thức giao hàng;\n:Tính tiền hàng;\n:Tính phí giao hàng;\n\nif (Tổng tiền &gt;= 5.000.000đ?) then (Có)\n    :Miễn phí chuyển phát nhanh\\ntrong ngày;\nelse (Không)\n    if (Tổng tiền &gt;= 1.000.000đ?) then (Có)\n        :Miễn phí chuyển phát nhanh;\n    else (Không)\n        :Tính phí giao hàng;\n    endif\nendif\n\n:Hiển thị tổng tiền thanh toán;\n:Nhập thông tin thẻ;\n:Kiểm tra thông tin thẻ;\n\nif (Thanh toán thành công?) then (Có)\n    :Ghi nhận đơn hàng;\n    :Lưu chi tiết đơn hàng;\n    :Lưu thông tin thanh toán;\n    :Hiển thị xác nhận đặt hàng;\nelse (Không)\n    :Thông báo thanh toán thất bại;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CNitgtTzQHGro8eLsCAe-184">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
