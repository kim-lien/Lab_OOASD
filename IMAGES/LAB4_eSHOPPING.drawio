        <UserObject label="Sequence Diagram - Đăng nhập" plantUmlId="title_29" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sequence Diagram - Đăng nhập" id="CNitgtTzQHGro8eLsCAe-84">
          <mxCell parent="CNitgtTzQHGro8eLsCAe-54" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="237.70809999999994" x="424.85924285714293" y="1087" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Sequence Diagram - Đặt hàng + Thanh toán\n\nskinparam linetype ortho\nskinparam shadowing false\nskinparam sequenceMessageAlign center\nskinparam responseMessageBelowArrow true\nskinparam maxMessageSize 70\n\nactor \&quot;Khách hàng\&quot; as KH\nboundary \&quot;FrmDatHang\&quot; as DatHang\nboundary \&quot;FrmThanhToan\&quot; as ThanhToan\ncontrol \&quot;DonHangService\&quot; as DHS\ncontrol \&quot;ThanhToanService\&quot; as TTS\ndatabase \&quot;SQL Server\&quot; as DB\nparticipant \&quot;Dịch vụ thanh toán\\ntrực tuyến\&quot; as DV\n\nKH -&gt; DatHang : Xác nhận đặt hàng\nactivate DatHang\n\nDatHang -&gt; DHS : Lấy thông tin giỏ hàng\nactivate DHS\nDHS -&gt; DB : Đọc giỏ hàng\nDB --&gt; DHS : Danh sách sản phẩm\nDHS --&gt; DatHang : Thông tin giỏ hàng\ndeactivate DHS\n\nKH -&gt; DatHang : Nhập thông tin người nhận\nKH -&gt; DatHang : Chọn phương thức giao hàng\n\nDatHang -&gt; DHS : Tính phí giao hàng\nactivate DHS\nDHS --&gt; DatHang : Trả về phí giao hàng\ndeactivate DHS\n\nDatHang -&gt; ThanhToan : Chuyển sang thanh toán\nactivate ThanhToan\n\nKH -&gt; ThanhToan : Nhập thông tin thẻ\nKH -&gt; ThanhToan : Xác nhận thanh toán\n\nThanhToan -&gt; TTS : XuLyThanhToan()\nactivate TTS\n\nTTS -&gt; DV : Kiểm tra giao dịch\nactivate DV\nDV --&gt; TTS : Kết quả giao dịch\ndeactivate DV\n\nalt Thanh toán thành công\n    TTS --&gt; ThanhToan : Thanh toán thành công\n\n    ThanhToan -&gt; DHS : TaoDonHang()\n    activate DHS\n\n    DHS -&gt; DB : Lưu đơn hàng\n    DB --&gt; DHS : Kết quả\n\n    DHS -&gt; DB : Lưu chi tiết đơn hàng\n    DB --&gt; DHS : Kết quả\n\n    DHS -&gt; DB : Lưu thông tin người nhận\n    DB --&gt; DHS : Kết quả\n\n    TTS -&gt; DB : Lưu giao dịch thanh toán\n    DB --&gt; TTS : Kết quả\n\n    DHS --&gt; ThanhToan : Đặt hàng thành công\n    deactivate DHS\n\n    ThanhToan --&gt; KH : Hiển thị xác nhận đơn hàng\n\nelse Thanh toán thất bại\n    TTS --&gt; ThanhToan : Thanh toán thất bại\n    ThanhToan --&gt; KH : Thông báo thanh toán thất bại\nend\n\ndeactivate TTS\ndeactivate ThanhToan\ndeactivate DatHang\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CNitgtTzQHGro8eLsCAe-85">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
