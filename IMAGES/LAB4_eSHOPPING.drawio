        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Activity Diagram - Quản lý giỏ hàng\n\nskinparam linetype ortho\nskinparam shadowing false\nskinparam activity {\n  BackgroundColor White\n  BorderColor Black\n  DiamondBackgroundColor White\n  DiamondBorderColor Black\n  ArrowColor Black\n}\n\nstart\n\n:Khách hàng mở giỏ hàng;\n:Hiển thị danh sách sản phẩm;\n\nif (Giỏ hàng có sản phẩm?) then (Có)\n\n    :Chọn sản phẩm cần thao tác;\n\n    if (Thay đổi số lượng?) then (Có)\n        :Nhập số lượng mới;\n        :Kiểm tra số lượng hợp lệ;\n        :Cập nhật số lượng;\n    else (Không)\n        if (Xóa sản phẩm?) then (Có)\n            :Xóa sản phẩm khỏi giỏ hàng;\n        else (Không)\n            :Giữ nguyên sản phẩm;\n        endif\n    endif\n\n    :Tính lại tổng tiền;\n    :Hiển thị giỏ hàng cập nhật;\n\n    if (Tiếp tục mua hàng?) then (Có)\n        :Quay lại danh sách sản phẩm;\n    else (Không)\n        :Tiến hành đặt hàng;\n    endif\n\nelse (Không)\n    :Hiển thị \&quot;Giỏ hàng trống\&quot;;\n    :Quay lại mua sắm;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CNitgtTzQHGro8eLsCAe-273">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
